---
import ToolLayout, { type FaqItem } from '@/layouts/ToolLayout.astro';
import PaymentFeeCalculatorTool from '@/components/tools/PaymentFeeCalculatorTool.vue';
import type { AffiliateOffer } from '@/components/tools/AffiliateCard.astro';
import { AFFILIATE_LINKS } from '@/consts';

const offers: AffiliateOffer[] = [
  {
    badge: '🟢 汇损极低首选',
    highlight: '中间市场汇率 0 额外加价',
    title: 'Wise 商业跨境多币种账户',
    description: '告别 PayPal 3.5%~4% 恶性汇损，直接以银行间真实汇率秒级结算美元、欧元与英镑，支持免手续费直提国内银联卡。',
    ctaText: '立即注册 Wise 享受超低费率',
    url: AFFILIATE_LINKS.wiseBusiness,
  },
  {
    badge: '🌍 跨境电商与外贸接单',
    highlight: '最高立减 1.2% 提现费率',
    title: 'Payoneer 派安盈外贸收款通道',
    description: '支持 Upwork、Fiverr、亚马逊全球站点及 B2B 国际电汇，阳光合规结汇至国内对公或法人个人账户，不占个人 5 万外汇额度。',
    ctaText: '开通派安盈领 $25 礼金',
    url: AFFILIATE_LINKS.payoneer,
  },
  {
    badge: '博主补贴 20% + 平台 5%',
    highlight: '首购立享 7.5 折',
    title: '阿里云 · 折扣补贴推广 (立享 7.5 折)',
    description: '博主主动补贴 20% 佣金 + 平台额外补贴 5% = 新用户首购享 25% 专属补贴优惠！爆款云服务器 ECS、OSS 存储与百炼 AI 算力通用。',
    ctaText: '立即领券 (折上 7.5 折)',
    url: AFFILIATE_LINKS.aliyunDiscount,
  },
];

const faqs: FaqItem[] = [
  {
    question: '什么是跨境支付中的“隐性汇损 (Hidden FX Markup)”？为什么它比手续费更狠？',
    answer:
      '许多传统跨国支付网关（如 PayPal、传统商业银行电汇）在宣传时只强调“收取 3.5%~4.4% 的交易手续费”，但在结算非美元/本币提现时，会在国际外汇中间市场真实汇率（Mid-market rate）的基础上，单方面向下加收 3.0% ~ 4.5% 的货币转换溢价点差（FX Spread）。这意味着一笔 $10,000 美元的款项，仅隐性汇损就被悄悄吃掉了 $350~$450，甚至超过了名义手续费总和。',
  },
  {
    question: '什么是反向倒推加价计算 (Gross-up Mode)？它的实际业务价值是什么？',
    answer:
      'Gross-up 是跨国商务洽谈与自由职业接单中的行业标准做法。当您与海外客户敲定“开发实收净额为 30,000 元（或 $5,000）”时，若直接向客户开具 $5,000 账单，扣除支付网关 4.4% 抽点与 3.5% 汇损后，您实际到手可能仅剩 $4,600 多元。本工具的 Gross-up 模式利用一阶代数公式精准反算客户应当支付的毛账单金额（Gross Invoiced Amount），并一键生成礼貌专业的双语说明函，将网关处理成本合规转嫁给客户承担。',
  },
  {
    question: '各主流通道（Wise、PayPal、Stripe、Payoneer、连连）分别适合哪些业务？',
    answer:
      '1. Wise：适合欧美客户直接公对公或私对私电汇，采用真实中间汇率，单笔 $2,000 以上综合损耗最低（通常低于 0.6%）；2. Stripe：适合 SaaS 订阅制软件与 Shopify 独立站出海，结算顺畅但国内提现需配合境外账户；3. PayPal：海外买家认可度最高，但小额交易（<$500）与非本币结算损耗极高；4. Payoneer / 连连国际：适合 Upwork、Fiverr 平台打款与跨境电商平台结算，国内合规结汇成熟。',
  },
  {
    question: '本工具的计算数据会实时更新吗？支持自定义调整费率参数吗？',
    answer:
      '支持。工具内置基于官方费率表归纳的静态费率数据集，并在界面底部提供「高级费率自定义滑块」。由于各支付渠道可能依据用户商户流水等级、跨境卡类型（Visa/Mastercard 国际卡额外 1%~1.5%）动态浮动，您可以随时在展开面板中微调固定费与百分比抽点，即时观察到账净额变化。',
  },
];
---

<ToolLayout
  lang="zh"
  category="dev-network"
  title="全球跨境支付渠道真实手续费、隐性汇损与到账净额精算器 · 7大通道对比"
  description="横向穿透 PayPal、Stripe、Wise、Payoneer、连连国际等 7 大主流收款通道阶梯扣点与货币转换溢价；支持反向倒推 (Gross-up) 账单金额与客户说明函。"
  alternateZh="/tools/payment-fee-calculator/"
  alternateEn="/en/tools/payment-fee-calculator/"
  wasmSizeLabel="多通道高精度精算"
  offers={offers}
  faqs={faqs}
>
  <PaymentFeeCalculatorTool client:load lang="zh" />

  <div slot="seo-content">
    <h2>跨境出海收款全景成本解构：别让“汇率黑盒”侵蚀你的辛勤利润</h2>
    <p>
      面向海外市场提供技术出海、软件出海（Micro-SaaS）、外贸独立站或自由职业接单时，跨境资金结算往往是极易被忽视的“利润黑洞”。许多开发者只关注代码架构与获客成本，却直到收到银行结汇水单时才发现，原本 20% 的项目净利润竟被<strong>高额固定入账费、跨境卡通道费、阶梯交易抽成以及不透明的汇率点差（FX Spread）</strong>蚕食殆尽。
    </p>

    <h3>跨境支付通道全链路成本解构四要素</h3>
    <ul>
      <li>
        <strong>1. 固定交易费 (Fixed Transaction Fee)：</strong>
        每笔交易固定扣除的金额（如 Stripe 为 $0.30，PayPal 为 $0.49），在 $10 以下的微额支付中占整体交易额的 3%~5%，对高频小额 SaaS 极其致命。
      </li>
      <li>
        <strong>2. 百分比交易佣金 (Percentage Rate)：</strong>
        基础通道抽点（如国内卡 2.9%，跨国发卡行额外加收 1.0%~1.5% Cross-Border Surcharge，合计达 3.9%~4.4%）。
      </li>
      <li>
        <strong>3. 隐性汇损溢价 (Hidden FX Markup)：</strong>
        当交易币种与结算入账币种不一致时（例如客户付美元，提现为人民币或欧元），平台在真实银行间中间汇率基础上强行扣减 2.5%~4.5% 作为二次套利。
      </li>
      <li>
        <strong>4. 中转行电汇费用 (Intermediary & SWIFT Fee)：</strong>
        传统银行国际电汇经过两到三家代理中转行时扣收的通道费，通常单笔固定扣收 $15 ~ $35 美元。
      </li>
    </ul>

    <h3>反向倒推加价 (Gross-up) 核心数学公式</h3>
    <p>
      当您希望在抵扣完全部通道成本与隐性汇损后，在账户中实收预期的<strong>目标到账净额 (Target Net Amount)</strong> 时，向客户开具的<strong>应收总金额 (Gross Invoiced Amount)</strong> 应当通过以下公式推导：
    </p>
    <pre><code>Gross Amount = (Target Net Amount + Fixed Fee) / (1 - (Percent Fee + FX Spread))</code></pre>
    <p>
      例如，若您希望实收 $1,000 美元净额，使用 PayPal 结算（费率 4.4% + $0.49 + 3.5% 汇损 = 综合抽成 7.9%），您必须向客户报价开具 <strong>$1,086.31</strong>，才能在支付网关完成扣费后精确到手 $1,000.00。
    </p>
  </div>
</ToolLayout>
