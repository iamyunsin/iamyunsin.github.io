---
import ToolLayout, { type FaqItem } from '@/layouts/ToolLayout.astro';
import SalaryBonusTaxTool from '@/components/tools/SalaryBonusTaxTool.vue';
import type { AffiliateOffer } from '@/components/tools/AffiliateCard.astro';
import { AFFILIATE_LINKS } from '@/consts';

const offers: AffiliateOffer[] = [
  {
    badge: '博主补贴 20% + 平台 5%',
    highlight: '首购立享 7.5 折',
    title: '阿里云 · 折扣补贴推广 (立享 7.5 折)',
    description: '博主主动补贴 20% 佣金 + 平台额外补贴 5% = 新用户首购享 25% 专属补贴优惠！个人副业建站、部署独立项目与百炼 AI 算力首选。',
    ctaText: '立即领券 (折上 7.5 折)',
    url: AFFILIATE_LINKS.aliyunDiscount,
  },
  {
    badge: '🌍 远程外包与美元收款',
    highlight: '真实中间汇率 · 零隐性汇损',
    title: 'Wise 跨境多币种个人/商业账户',
    description: '面向跨国远程工作者与数字游民，直接获取美元、欧元与英镑本地收款账号，支持低费率秒级直提国内银联卡与支付宝。',
    ctaText: '免费开通 Wise 多币种账户',
    url: AFFILIATE_LINKS.wiseBusiness,
  },
  {
    badge: '⚡ 开发者副业变现算力',
    highlight: '注册送 2000 万免费 Tokens',
    title: 'SiliconFlow 硅基流动 · 满血 DeepSeek API',
    description: '超低成本接入 DeepSeek-R1/V3 与 Qwen 系列大模型，快速构建属于自己的 AI 微SaaS 工具与第二收入曲线。',
    ctaText: '免费领 2000 万 Tokens',
    url: AFFILIATE_LINKS.siliconflow,
  },
];

const faqs: FaqItem[] = [
  {
    question: '为什么发年终奖会出现“多发 1 元，到手反而少拿几千甚至上万元”的跳档盲区？',
    answer:
      '这是由于全年一次性奖金（年终奖）在采用“单独计税”政策时，计税公式为：应纳税额 = 年终奖总额 × 适用税率 - 速算扣除数。其中适用税率是将年终奖除以 12 个月后对照月度税率表确定的，但“速算扣除数”却只允许扣除 1 个月的额度（而非 12 个月）！因此一旦年终奖跨过 3.6万、14.4万、30万、42万、66万、96万这 6 个临界点哪怕 1 元钱，全部奖金都会按高一档税率征税，而速算扣除数远远不够弥补税率差，从而形成 6 大著名的“年终奖跳档盲区”。',
  },
  {
    question: '年终奖“单独计税”和“并入当年综合所得计税”到底该怎么选？',
    answer:
      '1. 绝大多数学历/白领上班族（平时月薪扣除五险一金和专项附加扣除后已经需要缴纳个税）：选择【单独计税】几乎总是更划算，因为单独计税相当于给年终奖开辟了一个从 3% 重新起步的独立低税率通道；2. 刚毕业入职不久、全年工资收入扣除 6 万元起征点、五险一金及专项附加扣除后仍有负数结余（即平时工资完全免税且额度没用完）：选择【并入当年综合所得计税】可以用剩余免税额度抵扣年终奖，反而更省税。本工具会自动为您同步对比两种方案并高亮最优解。',
  },
  {
    question: '为什么我年初 1~3 月到手工资最高，到了下半年 9~12 月到手工资越来越少？',
    answer:
      '自新个税法实施以来，我国居民工资薪金采用“累计预扣法”计算每月预扣个税。年初前几个月，您的累计应纳税所得额较低（在 36,000 元以内），适用最低的 3% 税率；随着月份累加，下半年累计应纳税所得额突破 3.6 万、14.4 万甚至 30 万大关，边际预扣税率会阶梯式跳升至 10%、20%、25%，导致年底每月扣税变多、实发到手减少。但全年总税负与年度汇算清缴结果是完全一致的。',
  },
  {
    question: '如果不小心落入年终奖跳档盲区，有哪些合规的税务筹划补救方法？',
    answer:
      '1. 薪奖拆分法（最推荐）：在发薪前与公司 HR 或财务沟通，将年终奖金额精准卡在盲区临界点（如 36,000 元或 144,000 元），将超出的部分作为 12 月或次年 1 月的月度绩效工资发放；2. 汇算清缴调整法：若属于低底薪高提成结构，可在次年 3~6 月个税年度汇算清缴时，在个人所得税 App 中尝试切换为“并入综合所得计税”看是否能产生退税；3. 公益捐赠抵扣法：通过合法公益性社会组织进行公益捐赠，可在应纳税所得额 30% 以内据实扣除，将计税基数拉回低税率档位。',
  },
];
---

<ToolLayout
  lang="zh"
  category="ai-cost"
  title="薪资五险一金与年终奖个税筹划计算器 · 6大跳档盲区检测与单独/合并计税对比"
  description="精准测算月薪五险一金、双边公积金福利与 1~12 月累计预扣个税；内置年终奖单独计税 vs 并入综合所得 PK，智能检测“多发1元少拿数千元”的 6 大跳档盲区并给出最优拆分方案。"
  alternateZh="/tools/salary-bonus-tax-calculator/"
  alternateEn="/en/tools/salary-bonus-tax-calculator/"
  wasmSizeLabel="2027 最新个税政策"
  offers={offers}
  faqs={faqs}
>
  <SalaryBonusTaxTool client:load lang="zh" />

  <div slot="seo-content">
    <h2>看懂工资条与年终奖税单：为什么“发得多”有时不如“拆得巧”？</h2>
    <p>
      在职场谈薪（Offer Package 评估）与年底奖金发放季，许多工程师与职场人只盯着税前总包（Total Package），却忽略了<strong>五险一金缴纳基数封顶线、双边公积金隐性福利、专项附加扣除以及年终奖计税方式</strong>对实际可支配现金流的巨大影响。尤其在全年一次性奖金（年终奖）单独计税规则下，由于速算扣除数未按 12 个月放大，形成了多达 6 个令人瞠目结舌的<strong>“个税跳档盲区”</strong>。
    </p>

    <h3>核心规则解构：累计预扣法 vs 全年一次性奖金单独计税</h3>
    <ul>
      <li>
        <strong>1. 工资薪金“累计预扣法”公式：</strong>
        本期应预扣预缴税额 =（累计税前工资 - 累计免税收入 - 累计减除费用 5000元/月 × 月数 - 累计个人五险一金 - 累计专项附加扣除）× 预扣率 - 速算扣除数 - 累计已预扣税额。
      </li>
      <li>
        <strong>2. 年终奖“单独计税”优惠政策（延续至 2027 年 12 月 31 日）：</strong>
        将全年一次性奖金除以 12 个月，按其商数对照月度换算税率表确定适用税率和月度速算扣除数，单独计算纳税：<code>应纳税额 = 年终奖总额 × 适用税率 - 月度速算扣除数</code>。
      </li>
      <li>
        <strong>3. 年终奖 6 大跳档盲区成因：</strong>
        以第一档临界点 <code>¥36,000</code> 为例，按 3% 纳税仅需缴税 <code>¥1,080</code>，到手 <code>¥34,920</code>；一旦多发 1 元变成 <code>¥36,001</code>，除以 12 超过 3,000 元，全额跳入 10% 税率档，应纳税额瞬间飙升至 <code>36001 × 10% - 210 = ¥3,390.10</code>，到手仅剩 <code>¥32,610.90</code>——多发 1 元钱，凭空少拿 <strong>¥2,310.07</strong>！
      </li>
    </ul>

    <h3>谈薪与个税年度汇算清缴三大实战技巧</h3>
    <p>
      第一，<strong>足额申报 7 项专项附加扣除</strong>（租房 1500/月、房贷利息 1000/月、独生赡养老人 3000/月、子女教育与婴幼儿照护各 2000/月/孩），每年可直接减少数万元应纳税所得额；第二，<strong>算清双边公积金含金量</strong>，一线大厂 12% 全额双边公积金相当于每月额外多出 24% 的免税买房/租房现金流；第三，发年终奖前务必使用本工具的<strong>盲区检测与薪奖拆分筹划器</strong>，将超出临界点的奖金平移至月度工资，合规实现全年到手现金最大化。
    </p>
  </div>
</ToolLayout>
