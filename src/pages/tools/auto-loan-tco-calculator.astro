---
import ToolLayout, { type FaqItem } from '@/layouts/ToolLayout.astro';
import AutoLoanTcoTool from '@/components/tools/AutoLoanTcoTool.vue';
import type { AffiliateOffer } from '@/components/tools/AffiliateCard.astro';
import { AFFILIATE_LINKS } from '@/consts';

const offers: AffiliateOffer[] = [
  {
    badge: '博主补贴 20% + 平台 5%',
    highlight: '首购立享 7.5 折',
    title: '阿里云 · 折扣补贴推广 (立享 7.5 折)',
    description: '博主主动补贴 20% 佣金 + 平台额外补贴 5% = 新用户首购享 25% 专属补贴优惠！爆款云服务器 ECS、OSS 存储与 AI 算力通用。',
    ctaText: '立即领券 (折上 7.5 折)',
    url: AFFILIATE_LINKS.aliyunDiscount,
  },
  {
    badge: '🔥 轻量云特惠',
    highlight: '高性价比云主机',
    title: '腾讯云 · 轻量应用服务器专场',
    description: '适合部署车载智能互联转发服务、私人导航轨迹记录仪与家庭自动化数据看板。',
    ctaText: '查看腾讯云特惠活动',
    url: AFFILIATE_LINKS.tencentCloudLighthouse,
  },
  {
    badge: '🟢 汇损极低首选',
    highlight: '中间市场汇率 0 加价',
    title: 'Wise 跨境多币种账户',
    description: '海外租车、平行进口配件海淘与跨国差旅支付首选，直接按路孚特实时中间汇率秒级换汇扣款。',
    ctaText: '免费注册 Wise 账户',
    url: AFFILIATE_LINKS.wiseBusiness,
  },
];

const faqs: FaqItem[] = [
  {
    question: '为什么 4S 店销售说的“车贷年费率仅 2.5% ~ 3.0%”，算出来的真实年化利率 (IRR) 却接近 6%~8%？',
    answer:
      '因为 4S 店和汽车金融公司普遍采用【等本等息（Flat Rate）】计息法，而非银行房贷标准的【等额本息（Reducing Balance）】！在等本等息模式下，即便您已经还了 35 个月的本金，最后一个月依然要按照最初借的 100% 全额本金计算月息。由于您实际占用的平均本金只有约一半，真实年化利率（IRR）天然接近表面年费率的 1.85 ~ 1.95 倍；若再叠加首付时强制收取的 2,000~5,000 元“金融服务费/GPS费”，真实年化更是直接飙升至 7%~9%。',
  },
  {
    question: '车辆购置税是怎么计算的？为什么是除以 1.13 而不是直接乘以 10%？',
    answer:
      '我国车辆购置税法定税率为 10%，但计税依据是【不含增值税的裸车价格】。由于您在 4S 店谈妥的裸车发票价已经包含了 13% 的增值税，因此必须先执行价税分离公式：计税价格 = 裸车开票价 ÷ (1 + 13%)，然后再乘以 10%（即约等于裸车价的 8.85%）。对于符合条件的新能源汽车（NEV），目前享受免征（单车免税额上限 3 万元）或减半征收（单车减税额上限 1.5 万元）政策。',
  },
  {
    question: '买新能源电车真的比燃油车省钱吗？一年跑多少公里才适合买纯电/插混？',
    answer:
      '这取决于您的【年均行驶里程】与【是否有家用充电桩】。虽然电车每公里电费仅需 ¥0.07~¥0.12（燃油车约 ¥0.55~¥0.70/km），但电车每年保费普遍比同级油车贵 ¥800~¥1,500，且 5 年二手车残值率通常比同级热销油车低 5%~10%。如果享受购置税减免且同级裸车价相近，电车几乎落地即回本；但如果电车裸车溢价较高，一般要求每年行驶里程达到 10,000 ~ 15,000 公里以上，5 年省下的油费才能跑赢保费与折旧差额。',
  },
  {
    question: '4S 店高息高返（五年贷满 1~2 年提前还款免违约金）有哪些隐藏风险？',
    answer:
      '“五年分期、满两年提前还款、车价直降 1.5 万”是当前车市最流行的“高息高返”促销方案。避坑核心有三点：1. 必须将“满 24 期后提前结清免收违约金”白纸黑字写入银行贷款合同（口头承诺无效）；2. 用本工具算出前 24 期已支付的总利息 + 金融服务费，看是否小于销售给您的车价现金让利；3. 切勿忘记在第 24 期准时通过银行 App 提交提前结清申请。',
  },
];
---

<ToolLayout
  lang="zh"
  category="ai-cost"
  title="购车全款落地价、4S店车贷费率转真实年化 (IRR) 与油车vs电车 5 年回本计算器"
  description="一键算清裸车+购置税+交强险+商业险全款落地总价；将 4S 店“月费率/等本等息”套路秒转真实年化利率 IRR；同级燃油车与新能源车 5 年油电差价、保值率与回本公里数推演。"
  alternateZh="/tools/auto-loan-tco-calculator/"
  alternateEn="/en/tools/auto-loan-tco-calculator/"
  wasmSizeLabel="落地价与IRR精算"
  offers={offers}
  faqs={faqs}
>
  <AutoLoanTcoTool client:load lang="zh" />

  <div slot="seo-content">
    <h2>买车防坑终极算账指南：从全款落地价、车贷费率陷阱到 5 年油电 TCO 决战</h2>
    <p>
      走进 4S 店或新能源直营展厅谈价格时，购车者往往面临信息极度不对称的博弈：裸车优惠了 2 万，却在购置税、上牌费、商业险、金融服务费以及被称为“月费率仅 2 厘 5”的等本等息分期合同中被悄悄找补回来。本精算工作台将购车全生命周期拆解为三大透明模块，助您拿着精准数字上谈判桌。
    </p>

    <h3>一、全款购车落地价标准计算公式</h3>
    <pre><code>全款落地总价 = 裸车开票价 + 车辆购置税 + 交强险(¥950) + 车船税 + 上牌费 + 商业保险</code></pre>
    <p>
      其中<strong>车辆购置税</strong>的标准公式为 <code>(裸车开票价 ÷ 1.13) × 10%</code>。若购买新能源汽车，可根据当前阶段政策选择“免征（上限减免 30,000 元）”或“减半征收（上限减免 15,000 元）”，超过免税额门槛的豪华新能源车型只需对超出部分补缴购置税。
    </p>

    <h3>二、揭秘 4S 店“等本等息 (Flat Rate)”车贷的数学障眼法</h3>
    <p>
      假设向汽车金融公司贷款 <code>100,000 元</code>，分 <code>36 期（3 年）</code>归还，销售声称<strong>“年费率仅 3.0%（月费率 0.25%）”</strong>：
    </p>
    <ul>
      <li>
        <strong>表面算法：</strong>每月固定利息 = <code>100,000 × 0.25% = 250 元</code>，3 年总利息 = <code>9,000 元</code>。看似年息只有 3%。
      </li>
      <li>
        <strong>真实资金占用真相：</strong>因为您每个月都在归还 <code>2,777.78 元</code> 本金，到了第 36 个月您手里其实只欠银行最后 <code>2,778 元</code>，但 4S 店依然按 <code>100,000 元</code> 收您 250 元月息！通过牛顿迭代法求解内部收益率（IRR），其<strong>真实单利年化高达 5.66%</strong>；若再扣除首付时收取的 <code>3,000 元金融服务费</code>，实际到手本金仅 9.7 万元，<strong>真实年化利率直接突破 7.6%</strong>！
      </li>
    </ul>

    <h3>三、燃油车 vs 新能源电车 5 年总拥有成本 (TCO) 模型</h3>
    <p>
      衡量买油车还是买电车，绝不能只看“每公里几毛钱油费”，而应当计算 5 年持有周期的<strong>总拥有成本 (Total Cost of Ownership)</strong>：
    </p>
    <pre><code>5年净持有成本 (TCO) = 落地总价 + 5年油费/电费 + 5年保养费 + 5年保险车船税 - 5年后二手残值</code></pre>
  </div>
</ToolLayout>
