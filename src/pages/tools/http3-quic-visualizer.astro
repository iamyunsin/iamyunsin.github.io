---
import ToolLayout, { type FaqItem } from '@/layouts/ToolLayout.astro';
import Http3QuicVisualizerTool from '@/components/tools/Http3QuicVisualizerTool.vue';
import type { AffiliateOffer } from '@/components/tools/AffiliateCard.astro';
import { AFFILIATE_LINKS } from '@/consts';

const offers: AffiliateOffer[] = [
  {
    badge: '⚡ 一键开启 HTTP/3 QUIC',
    highlight: '免改 Nginx 配置',
    title: 'Cloudflare 全球 CDN 与边缘网络 — 默认免费开启 HTTP/3 + 0-RTT',
    description: '无需手动重编译 Nginx 1.25+，接入 Cloudflare 即可一键开启 QUIC / HTTP/3 与 0-RTT 连接恢复。',
    ctaText: '免费开启 Cloudflare HTTP/3 加速',
    url: AFFILIATE_LINKS.cloudflareWorkers,
  },
  {
    badge: '🇨🇳 自建 Nginx 1.25+ HTTP/3',
    highlight: '开放 UDP 443 端口',
    title: '腾讯云轻量应用服务器 — 独立博客开启原生 QUIC 首选',
    description: '支持在防火墙一键放行 UDP 443 端口并部署 Nginx 1.25+ 原生 HTTP/3 协议，正如本站实战方案所用。',
    ctaText: '查看腾讯云轻量服务器特惠',
    url: AFFILIATE_LINKS.tencentCloudLighthouse,
  },
];

const faqs: FaqItem[] = [
  {
    question: '既然 HTTP/2 已经支持了多路复用，为什么还会存在“队头阻塞（Head-of-Line Blocking）”？',
    answer:
      'HTTP/2 虽然在应用层通过二进制分帧实现了单连接多流并发（解决了 HTTP/1.1 的应用层队头阻塞），但它底层仍然运行在单一的 TCP 连接之上。TCP 协议强制要求字节流严格按序到达操作系统内核缓冲区——一旦第 1 号流（例如 app.js）丢失了一个 TCP 报文段，哪怕第 2、3、4 号流（如 style.css、图片）的数据包已经完整抵达网卡，操作系统内核也必须把它们全部扣留在缓冲区中等待第 1 号流重传成功，从而引发“一包丢失、全流罚站”的 TCP 传输层队头阻塞。',
  },
  {
    question: 'HTTP/3 (QUIC) 是如何彻底解决传输层队头阻塞并实现 0-RTT 握手的？',
    answer:
      'HTTP/3 弃用了 TCP，改用基于 UDP 的 QUIC 协议：1. 传输层多路复用：每个数据流（Stream）拥有独立的序列号与滑动窗口，流 #1 丢包重传时，流 #2、#3、#4 的数据包可立即交付给上层浏览器渲染；2. 握手合并：将传输层握手与 TLS 1.3 加密握手合并，首次连接仅需 1-RTT，二次重连更可通过缓存的会话票据实现 0-RTT（首包直接携带 HTTP 请求数据）。',
  },
];
---

<ToolLayout
  lang="zh"
  category="dev-network"
  title="HTTP/2 (TCP) vs HTTP/3 (QUIC) 0-RTT 握手与丢包队头阻塞 (HoL) 对比模拟器"
  description="配套《让网站支持HTTP/3》博文的交互式网络实验室：自由调节 RTT 延迟与丢包率滑块，直观对比 TCP+TLS 握手与 QUIC 0-RTT，演示单包丢失时 HTTP/2 全流卡死 vs HTTP/3 独立流并发传输。"
  alternateZh="/tools/http3-quic-visualizer/"
  alternateEn="/en/tools/http3-quic-visualizer/"
  wasmSizeLabel="91.9 KB Rust Wasm"
  offers={offers}
  faqs={faqs}
>
  <Http3QuicVisualizerTool client:load lang="zh" />

  <div slot="seo-content">
    <h2>为什么弱网与高延迟环境下 HTTP/3 (QUIC) 能带来断代级的加载提速？</h2>
    <p>
      本模拟器是作者实战博文《<a href="/blog/knowledge/enable-http3">让网站支持HTTP/3</a>》的配套交互式实验工具。在地铁、高铁或跨国高延迟网络中，微小的丢包率（如 2%~5%）就会导致传统 HTTP/2 网站出现明显的白屏卡顿：
    </p>
    <ul>
      <li><strong>握手往返缩减（2-RTT → 1-RTT / 0-RTT）：</strong> 传统 HTTPS (HTTP/2) 需要先完成 TCP 三次握手（1-RTT），再完成 TLS 握手（1-RTT）；而 QUIC 将传输层与加密层握手深度融合，支持在第一个数据包中直接发送业务请求（0-RTT）。</li>
      <li><strong>流级别独立重传（Stream-Level Independence）：</strong> 拖动上方滑块将丢包率调至 <code>3%</code> 以上，即可在瀑布图中直观看到 HTTP/2 因 TCP 顺序交付限制导致所有静态资源同步增加红色阻塞条，而 HTTP/3 中未丢包的资源流则完全不受影响。</li>
    </ul>
  </div>
</ToolLayout>
