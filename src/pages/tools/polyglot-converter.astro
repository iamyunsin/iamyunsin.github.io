---
import ToolLayout, { type FaqItem } from '@/layouts/ToolLayout.astro';
import PolyglotConverterTool from '@/components/tools/PolyglotConverterTool.vue';
import type { AffiliateOffer } from '@/components/tools/AffiliateCard.astro';
import { AFFILIATE_LINKS } from '@/consts';

const offers: AffiliateOffer[] = [
  {
    badge: '博主补贴 20% + 平台 5%',
    highlight: '首购立享 7.5 折',
    title: '阿里云 · 折扣补贴推广 (立享 7.5 折)',
    description: '博主主动补贴 20% 佣金 + 平台额外补贴 5% = 新用户首购享 25% 专属补贴优惠！爆款云服务器 ECS、OSS 存储与百炼 AI 算力通用。',
    ctaText: '立即领券 (折上 7.5 折)',
    url: AFFILIATE_LINKS.aliyunDiscount,
  },
  {
    badge: '🤖 智能代码 API',
    highlight: '邀请码 mxiALm95 · 送 ¥16',
    title: '硅基流动 SiliconFlow — 满血 DeepSeek-R1 代码模型',
    description: '免海外卡高速直连，极速调用满血版 DeepSeek-R1 / V3 与 Qwen-2.5-Coder，快速生成全栈工程胶水代码与单元测试。',
    ctaText: '免费开通领 ¥16 额度',
    url: AFFILIATE_LINKS.siliconflow,
  },
  {
    badge: '⚡ 全球边缘部署',
    highlight: '免费全球 CDN + SSL',
    title: 'Cloudflare Workers & Pages 边缘托管',
    description: '免运维托管 TypeScript、Go WASM 与现代化静态前端，全球 300+ 数据中心边缘秒级直出。',
    ctaText: '免费部署在 Cloudflare',
    url: AFFILIATE_LINKS.cloudflareWorkers,
  },
];

const faqs: FaqItem[] = [
  {
    question: '我粘贴进来的企业内部 JSON 数据或核心 SQL DDL 会被上传到云端吗？',
    answer:
      '绝对不会。数据安全是全栈研发的第一红线。本转换工场采用 100% 纯浏览器端沙箱解析架构，所有抽象语法树（AST）分析、词法扫描及多语言代码合成全部在您本地浏览器的 JavaScript / WebAssembly 运行环境中瞬时完成。数据绝不离开您的终端内存，即使在断网离线、企业内网无外网权限的环境下亦可放心粘贴生产级测试数据。',
  },
  {
    question: '生成的 TypeScript 代码支持 Zod v3 运行时数据校验 Schema 吗？',
    answer:
      '完美支持。在现代全栈开发（如 Next.js、Nuxt 3 或 tRPC）中，仅有编译期 TypeScript interface 无法防御不受信任的外部 API 异常输入。本工具支持一键生成带有 z.object()、z.string().nullable()、z.array() 的 Zod v3 Schema，并自动附带 export type MyType = z.infer<typeof MySchema>; 导出，实现编译期与运行时双重类型安全。',
  },
  {
    question: '转换生成的 Go struct 和 Rust serde 是否符合生产级严苛代码规范？',
    answer:
      '完全符合。生成的 Go 结构体自动注入严格符合规范的 `json:"field_name" db:"field_name"` Tag 标签，针对可空字段自动推断为指针类型（*string / *int）；生成的 Rust 结构体自动派生 #[derive(Debug, Clone, Serialize, Deserialize)]，针对驼峰/下划线命名注入 #[serde(rename_all = "camelCase")] 与 Option<T> 防御性封装。',
  },
  {
    question: '支持直接将浏览器 Network 面板复制的 cURL 命令转换为 Python 代码吗？',
    answer:
      '支持。直接将形如 curl "https://api.example.com" -H "Authorization: Bearer xxx" --data-raw "..." 粘贴进输入框，工具将自动提取 HTTP Method、URL 路由参数、Headers 请求头及 Body 负载，一键转换为 Python (httpx / requests)、Node.js (fetch / axios) 及 Go (net/http) 原生客户端网络请求代码。',
  },
];
---

<ToolLayout
  lang="zh"
  category="dev-network"
  title="全栈多语言类型与数据结构转换工场 (JSON / YAML / SQL DDL / cURL) · 100% 离线隐私"
  description="100% 浏览器本地解析，绝不上传私密数据。一键将 JSON/YAML/SQL DDL/cURL 转换为 TypeScript (Interface + Zod v3)、Go struct、Rust serde、Python Pydantic v2 与 Prisma。"
  alternateZh="/tools/polyglot-converter/"
  alternateEn="/en/tools/polyglot-converter/"
  wasmSizeLabel="离线多语言 AST 引擎"
  offers={offers}
  faqs={faqs}
>
  <PolyglotConverterTool client:load lang="zh" />

  <div slot="seo-content">
    <h2>全栈工程师的类型安全护城河：为什么我们需要端到端代码结构转换？</h2>
    <p>
      在当今微服务与现代全栈 Web 开发体系中，系统间的通信往往依赖于非类型化的 <strong>JSON 载荷、PostgreSQL / MySQL 数据库 DDL 或第三方 RESTful API</strong>。若全凭工程师人工对照接口文档手工手写 TypeScript 接口、Go 结构体或 Python 数据模型，不仅枯燥低效，更极易引发诸如“字段名大小写拼错”、“后端下发 null 导致前端白屏”或“浮点数精度丢失”等高危线上事故。
    </p>

    <h3>主流现代编程语言类型映射规范与边界处理</h3>
    <ul>
      <li>
        <strong>TypeScript (Interface + Zod v3)：</strong>
        针对可空字段注入 <code>null | undefined</code> 联合类型，并一键合成 Zod Schema 以支撑前后端同构输入校验。
      </li>
      <li>
        <strong>Go (Golang Struct)：</strong>
        严格遵循 Go 语言首字母大写导出规范与 Idiomatic 命名惯例，自动补齐标准 <code>`json:"fieldName,omitempty"`</code> 标签，指针类型精准规避零值歧义。
      </li>
      <li>
        <strong>Rust (Serde Struct)：</strong>
        自动补充 <code>#[derive(Serialize, Deserialize)]</code>，对于非必须字段自动封装为 <code>Option&lt;T&gt;</code>，无缝兼容 <code>serde_json</code> 零拷贝反序列化。
      </li>
      <li>
        <strong>Python (Pydantic v2 BaseModels)：</strong>
        契合 Python 3.12+ 强类型生态，生成基于 <code>ConfigDict(strict=True)</code> 的严格校验类，全面适配 FastAPI 后端接口。
      </li>
      <li>
        <strong>Prisma ORM Schema：</strong>
        直接解析原生 SQL <code>CREATE TABLE</code> DDL 语句，自动推断主键 <code>@id @default(autoincrement())</code>、时间戳 <code>@updatedAt</code> 与关联映射。
      </li>
    </ul>

    <h3>开发避坑指南：三类常见跨语言类型陷阱</h3>
    <ol>
      <li>
        <strong>动态键名 (Dynamic Map/Dict)：</strong> 当 JSON 中的 key 是非固定 ID（如用户 UID）时，应自动生成 <code>Record&lt;string, T&gt;</code> (TS) 或 <code>map[string]T</code> (Go)，而非生成僵硬的固定字段。
      </li>
      <li>
        <strong>长整型雪崩 (64-bit Integer Overflow)：</strong> JavaScript 的 <code>Number.MAX_SAFE_INTEGER</code> (2^53 - 1) 无法安全承载 Twitter Snowflake ID 或区块链 64 位无符号整数，必须推导为 <code>bigint</code> 或 <code>string</code>。
      </li>
      <li>
        <strong>时间戳格式混淆：</strong> 区分精确到秒的 Unix Timestamp (int64) 与 ISO 8601 字符串时间（如 <code>2026-10-31T14:00:00Z</code>），避免反序列化时抛出格式解析崩溃。
      </li>
    </ol>
  </div>
</ToolLayout>
