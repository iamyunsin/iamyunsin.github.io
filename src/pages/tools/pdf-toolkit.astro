---
import ToolLayout, { type FaqItem } from '@/layouts/ToolLayout.astro';
import PdfToolkitTool from '@/components/tools/PdfToolkitTool.vue';
import type { AffiliateOffer } from '@/components/tools/AffiliateCard.astro';
import { AFFILIATE_LINKS } from '@/consts';

const offers: AffiliateOffer[] = [
  {
    badge: '🇨🇳 企业文档归档存储',
    highlight: '对象存储 + CDN 组合特惠',
    title: '腾讯云对象存储 COS / 阿里云 OSS 专场',
    description: '将脱敏加水印后的合同扫描件、电子发票 PDF 安全归档至自有云端私有读写存储桶，合规低成本。',
    ctaText: '领取腾讯云官方特惠礼包',
    url: AFFILIATE_LINKS.tencentCloud,
  },
  {
    badge: '☁️ 零流量费私有文档库',
    highlight: '每月 10GB 永久免费',
    title: 'Cloudflare R2 对象存储 — 零出口带宽费的全球文档托管',
    description: '搭配预签名 URL (Presigned URL) 分发大型 PDF 产品手册、电子书与合同附件，彻底免除高昂下载流量费。',
    ctaText: '免费开通 Cloudflare R2',
    url: AFFILIATE_LINKS.cloudflareR2,
  },
  {
    badge: '🎨 品牌提案排版神器',
    highlight: '支持导出印刷级 PDF',
    title: 'Canva 可画 Pro — 商业计划书与高清长图排版工作台',
    description: '内置海量商业提案、报价单、产品画册模板，支持一键导出带出血线的标准印刷级 PDF。',
    ctaText: '免费体验 Canva Pro 专业版',
    url: AFFILIATE_LINKS.canvaPro,
  },
];

const faqs: FaqItem[] = [
  {
    question: '为什么千万不要把公司合同、身份证正反面或财务发票上传到普通的“在线转 PDF”网站？',
    answer:
      '绝大多数免费在线 PDF 合成网站采用后端服务器处理模式：您上传的身份证扫描件、房产证、商业保密合同与银行流水会先传输并保存在第三方云主机硬盘上，存在极高的隐私泄露与撞库转卖风险。本工具采用 100% 纯前端二进制流架构，直接在您本地浏览器的内存中构建 ISO PDF 1.4 交叉引用表（xref）与 DCTDecode 图像流，文件从始至终不离开您的电脑或手机。',
  },
  {
    question: '在证件或合同扫描件上添加“斜体防伪水印”有什么用？',
    answer:
      '在提交身份证、营业执照或合同扫描件办理租房、开户、投标等业务时，叠加一行半透明的斜体水印（如“仅供办理 XX 业务使用，他用无效”），既不会遮挡关键文字影响审核，又能有效防止不法分子将您的高清证件扫描件截留挪作网贷或冒名注册。',
  },
  {
    question: '本工具生成的 PDF 文件需要依赖浏览器的“打印另存为”功能吗？',
    answer:
      '完全不需要！本工具内置了纯 TypeScript 编写的底层 PDF 1.4 二进制封装引擎，点击按钮即可直接下载标准的 .pdf 后缀文件，无论在微信、Adobe Acrobat、macOS 预览还是手机端都能直接原样打开。',
  },
];
---

<ToolLayout
  lang="zh"
  category="media-doc"
  title="本地安全 PDF 工具箱 — 多张图片/扫描件合成标准 A4 PDF、防伪水印与高清长图拼接"
  description="100% 纯浏览器本地运行的隐私级 PDF 与文档图像工作台。支持多张图片/合同扫描件自由排序、90° 旋转、叠加防盗用斜体水印并直接输出标准 PDF 1.4 二进制文件，以及多页文档无缝拼接高清长图。"
  alternateZh="/tools/pdf-toolkit/"
  alternateEn="/en/tools/pdf-toolkit/"
  wasmSizeLabel="PDF 1.4 Binary Engine"
  offers={offers}
  faqs={faqs}
>
  <PdfToolkitTool client:load lang="zh" />

  <div slot="seo-content">
    <h2>告别云端泄密与付费墙：100% 纯前端二进制 PDF 1.4 合成与长图拼接工作台</h2>
    <p>
      在日常处理<strong>劳动合同扫描件、身份证正反面、电子发票报销单、房产契税证明</strong>等高度敏感的个人与企业文档时，使用传统的在线 PDF 转换器不仅经常遭遇“超过 2 页需充值 VIP”的套路，更等同于将核心机密拱手上传给未知的第三方服务器。
    </p>
    <ul>
      <li><strong>原生二进制 PDF 1.4 流式构建：</strong> 工具直接在浏览器内存中组装 PDF Catalog、Pages 树、<code>/Filter /DCTDecode</code> 图像对象流与精确到字节偏移量的 <code>xref</code> 交叉引用表，零外部依赖、零网络上传，秒级下载标准 <code>.pdf</code> 文件。</li>
      <li><strong>内置防盗用安全水印图层：</strong> 一键为每页扫描件自动烙印半透明斜体防伪水印与页码（<code>Page X / N</code>），从源头杜绝证件与合同被二次盗用。</li>
      <li><strong>多页文档无缝拼接高清长图：</strong> 支持将多页合同、PPT 讲义或手机长截图垂直拼接为单张高清 PNG / WebP 长图，方便在微信公众号、小红书或工作群中一图顺畅阅览。</li>
    </ul>
  </div>
</ToolLayout>
