---
import BaseHead from '@/components/BaseHead.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import BodyWrapper from '@/components/BodyWrapper.astro';
import AdSlot from '@/components/tools/AdSlot.astro';
import { SITE, TOOLS } from '@/consts';
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title={`Privacy-First Developer & AI Tools (Rust Wasm) · ${SITE.titleEn}`}
      description={SITE.descriptionEn}
      alternateZh="/tools/"
      alternateEn="/en/tools/"
    />
  </head>
  <body>
    <Header lang="en" switchLangUrl="/tools/" />
    <BodyWrapper>
      <header class="tools-banner">
        <div class="banner-top">
          <span class="wasm-tag">⚡ Powered by Rust + WebAssembly</span>
          <a href="/tools/" class="lang-link">🌐 切换到中文版 →</a>
        </div>
        <h1 class="tools-title">🛠️ Privacy-First Indie Developer Tools</h1>
        <p class="tools-subtitle">
          100% Client-Side execution powered by micro-compiled Rust WebAssembly modules (~28 KB per tool). Your prompts, files, and keys never leave your browser.
        </p>
      </header>

      <section class="tools-grid">
        {TOOLS.map((tool) => (
          <a
            href={tool.pathEn}
            class={`tool-card ${tool.status === 'coming-soon' ? 'is-upcoming' : ''}`}
          >
            <div class="card-meta">
              <span class={`status-badge ${tool.status}`}>{tool.badgeEn}</span>
              {tool.wasmPowered && <span class="engine-badge">Rust Wasm</span>}
            </div>
            <h2 class="card-title">{tool.titleEn}</h2>
            <p class="card-desc">{tool.descriptionEn}</p>
            <div class="card-footer">
              <span class="enter-text">
                {tool.status === 'live' ? 'Launch Tool →' : 'Coming Soon'}
              </span>
            </div>
          </a>
        ))}
      </section>

      <AdSlot lang="en" category="ai-cost" position="bottom" />
    </BodyWrapper>
    <Footer />
  </body>
</html>

<style lang="less">
  .tools-banner {
    margin-bottom: 24px;
    padding: 24px 28px;
    border-radius: 16px;
    background: var(--author-banner);
    border: 1px solid var(--border-color);

    @media (max-width: 640px) {
      padding: 16px 14px;
      border-radius: 12px;
      margin-bottom: 16px;
    }
  }

  .banner-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 10px;
    flex-wrap: wrap;
    gap: 8px;
  }

  .wasm-tag {
    display: inline-flex;
    align-items: center;
    padding: 3px 10px;
    border-radius: 999px;
    font-size: 12px;
    font-weight: 700;
    background-color: var(--accent-soft);
    color: var(--accent);
    border: 1px solid var(--accent-border);
  }

  .lang-link {
    font-size: 13px;
    font-weight: 600;
    color: var(--accent);
    text-decoration: none;

    &:hover {
      text-decoration: underline;
    }
  }

  .tools-title {
    margin: 0 0 8px;
    font-size: 24px;
    font-weight: 800;
    color: var(--text-primary);
  }

  .tools-subtitle {
    margin: 0;
    font-size: 14px;
    color: var(--text-secondary);
    line-height: 1.6;
  }

  .tools-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 18px;
    margin-bottom: 24px;

    @media (max-width: 820px) {
      grid-template-columns: 1fr;
    }
  }

  .tool-card {
    display: flex;
    flex-direction: column;
    padding: 22px 24px;
    border-radius: 16px;
    background-color: var(--bg-surface);
    border: 1px solid var(--border-color);
    text-decoration: none;
    transition: all 0.22s ease;
    min-width: 0;

    @media (max-width: 640px) {
      padding: 16px 14px;
      border-radius: 12px;
    }

    &:hover {
      border-color: var(--accent-border);
      transform: translateY(-2px);
      box-shadow: var(--shadow-md);
    }

    &.is-upcoming {
      opacity: 0.78;
    }
  }

  .card-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    margin-bottom: 12px;
  }

  .status-badge {
    font-size: 11.5px;
    font-weight: 700;
    padding: 3px 10px;
    border-radius: 999px;
    background-color: var(--accent-soft);
    color: var(--accent);

    &.coming-soon {
      background-color: var(--bg-muted);
      color: var(--text-muted);
    }
  }

  .engine-badge {
    font-size: 11px;
    font-weight: 600;
    color: var(--text-muted);
    font-family: monospace;
  }

  .card-title {
    margin: 0 0 10px;
    font-size: 17px;
    font-weight: 700;
    color: var(--text-primary);
    line-height: 1.4;
  }

  .card-desc {
    margin: 0 0 16px;
    font-size: 13.5px;
    color: var(--text-secondary);
    line-height: 1.6;
    flex: 1;
  }

  .card-footer {
    padding-top: 12px;
    border-top: 1px dashed var(--border-color);
  }

  .enter-text {
    font-size: 13px;
    font-weight: 700;
    color: var(--accent);
  }
</style>
