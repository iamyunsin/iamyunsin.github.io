---
import BaseHead from '@/components/BaseHead.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import BodyWrapper from '@/components/BodyWrapper.astro';
import AdSlot from '@/components/tools/AdSlot.astro';
import { SITE, UTILITY_TOOLS, LAB_TOOLS } from '@/consts';
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title={`Privacy-First Developer Tools & Interactive Principle Labs (Rust Wasm) · ${SITE.titleEn}`}
      description={SITE.descriptionEn}
      alternateZh="/tools/"
      alternateEn="/en/tools/"
    />
  </head>
  <body>
    <Header lang="en" switchLangUrl="/tools/" />
    <BodyWrapper>
      <header class="tools-banner">
        <div class="banner-top">
          <span class="wasm-tag">⚡ Powered by Rust + WebAssembly</span>
          <a href="/tools/" class="lang-link">🌐 切换到中文版 →</a>
        </div>
        <h1 class="tools-title">🛠️ Privacy-First Developer Tools & Interactive Labs</h1>
        <p class="tools-subtitle">
          100% Client-Side execution powered by micro-compiled Rust WebAssembly modules. Explore production utilities and interactive architecture visualizers.
        </p>
      </header>

      <div class="section-heading">
        <h2 class="section-title">⚡ Developer & AI Utilities</h2>
        <span class="section-desc">Zero-upload local utilities for LLM pricing, image compression, mobile deep links, and Web3 security</span>
      </div>

      <section class="tools-grid">
        {UTILITY_TOOLS.map((tool) => (
          <a
            href={tool.pathEn}
            class={`tool-card ${tool.status === 'coming-soon' ? 'is-upcoming' : ''}`}
          >
            <div class="card-meta">
              <span class={`status-badge ${tool.status}`}>{tool.badgeEn}</span>
              {tool.wasmPowered && <span class="engine-badge">Rust Wasm</span>}
            </div>
            <h3 class="card-title">{tool.titleEn}</h3>
            <p class="card-desc">{tool.descriptionEn}</p>
            <div class="card-footer">
              <span class="enter-text">
                {tool.status === 'live' ? 'Launch Tool →' : 'Coming Soon'}
              </span>
            </div>
          </a>
        ))}
      </section>

      <div id="labs" class="section-heading labs-heading">
        <h2 class="section-title">🧪 Interactive Principle Visualizers & Sandboxes</h2>
        <span class="section-desc">Step-by-step visualizers for Vue 3 compilation, Virtual DOM Fast Diff, JS Event Loop, and HTTP/3 QUIC</span>
      </div>

      <section class="tools-grid">
        {LAB_TOOLS.map((tool) => (
          <div class="tool-card lab-card">
            <a href={tool.pathEn} class="card-main-link">
              <div class="card-meta">
                <span class="status-badge lab-badge">{tool.badgeEn}</span>
                {tool.wasmPowered && <span class="engine-badge">Rust Wasm</span>}
              </div>
              <h3 class="card-title">{tool.titleEn}</h3>
              <p class="card-desc">{tool.descriptionEn}</p>
            </a>
            {tool.relatedPosts && tool.relatedPosts.length > 0 && (
              <div class="related-post-bar">
                <span class="related-label">📖 Companion Deep-Dive Article:</span>
                <div class="related-links">
                  {tool.relatedPosts.map((post) => (
                    <a href={post.url} class="related-link">{post.titleEn}</a>
                  ))}
                </div>
              </div>
            )}
            <div class="card-footer">
              <a href={tool.pathEn} class="enter-text">Launch Interactive Lab →</a>
            </div>
          </div>
        ))}
      </section>

      <AdSlot lang="en" category="ai-cost" position="bottom" />
    </BodyWrapper>
    <Footer />
  </body>
</html>

<style lang="less">
  .tools-banner {
    margin-bottom: 24px;
    padding: 24px 28px;
    border-radius: 16px;
    background: var(--author-banner);
    border: 1px solid var(--border-color);

    @media (max-width: 640px) {
      padding: 16px 14px;
      border-radius: 12px;
      margin-bottom: 16px;
    }
  }

  .banner-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 10px;
    flex-wrap: wrap;
    gap: 8px;
  }

  .wasm-tag {
    display: inline-flex;
    align-items: center;
    padding: 3px 10px;
    border-radius: 999px;
    font-size: 12px;
    font-weight: 700;
    background-color: var(--accent-soft);
    color: var(--accent);
    border: 1px solid var(--accent-border);
  }

  .lang-link {
    font-size: 13px;
    font-weight: 600;
    color: var(--accent);
    text-decoration: none;

    &:hover {
      text-decoration: underline;
    }
  }

  .tools-title {
    margin: 0 0 8px;
    font-size: 24px;
    font-weight: 800;
    color: var(--text-primary);
  }

  .tools-subtitle {
    margin: 0;
    font-size: 14px;
    color: var(--text-secondary);
    line-height: 1.6;
  }

  .section-heading {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 8px;
    margin: 8px 0 14px;
    padding-bottom: 10px;
    border-bottom: 1px dashed var(--border-color);

    &.labs-heading {
      margin-top: 32px;
      scroll-margin-top: 84px;
    }
  }

  .section-title {
    margin: 0;
    font-size: 18px;
    font-weight: 800;
    color: var(--text-primary);
  }

  .section-desc {
    font-size: 13px;
    color: var(--text-muted);
  }

  .tools-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 18px;
    margin-bottom: 24px;

    @media (max-width: 820px) {
      grid-template-columns: 1fr;
    }
  }

  .tool-card {
    display: flex;
    flex-direction: column;
    padding: 22px 24px;
    border-radius: 16px;
    background-color: var(--bg-surface);
    border: 1px solid var(--border-color);
    text-decoration: none;
    transition: all 0.22s ease;
    min-width: 0;

    @media (max-width: 640px) {
      padding: 16px 14px;
      border-radius: 12px;
    }

    &:hover {
      border-color: var(--accent-border);
      transform: translateY(-2px);
      box-shadow: var(--shadow-md);
    }

    &.is-upcoming {
      opacity: 0.78;
    }
  }

  .card-main-link {
    text-decoration: none;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .card-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    margin-bottom: 12px;
  }

  .status-badge {
    font-size: 11.5px;
    font-weight: 700;
    padding: 3px 10px;
    border-radius: 999px;
    background-color: var(--accent-soft);
    color: var(--accent);

    &.coming-soon {
      background-color: var(--bg-muted);
      color: var(--text-muted);
    }
  }

  .engine-badge {
    font-size: 11px;
    font-weight: 600;
    color: var(--text-muted);
    font-family: monospace;
  }

  .card-title {
    margin: 0 0 10px;
    font-size: 17px;
    font-weight: 700;
    color: var(--text-primary);
    line-height: 1.4;
  }

  .card-desc {
    margin: 0 0 14px;
    font-size: 13.5px;
    color: var(--text-secondary);
    line-height: 1.6;
    flex: 1;
  }

  .related-post-bar {
    margin-bottom: 12px;
    padding: 10px 12px;
    border-radius: 10px;
    background-color: var(--bg-muted);
    border: 1px solid var(--border-subtle);
    font-size: 12px;
  }

  .related-label {
    font-weight: 700;
    color: var(--text-secondary);
    display: block;
    margin-bottom: 4px;
  }

  .related-links {
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  .related-link {
    color: var(--accent);
    text-decoration: none;
    font-weight: 600;
    line-height: 1.4;

    &:hover {
      text-decoration: underline;
    }
  }

  .card-footer {
    padding-top: 12px;
    border-top: 1px dashed var(--border-color);
  }

  .enter-text {
    font-size: 13px;
    font-weight: 700;
    color: var(--accent);
    text-decoration: none;
  }
</style>
