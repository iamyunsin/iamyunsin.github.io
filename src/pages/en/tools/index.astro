---
import BaseHead from '@/components/BaseHead.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import BodyWrapper from '@/components/BodyWrapper.astro';
import AdSlot from '@/components/tools/AdSlot.astro';
import { SITE, TOOLS, TOOL_CATEGORIES, getToolsByGroup } from '@/consts';

const hotKeywordsEn = [
  { label: '🔥 Video to GIF', q: 'gif' },
  { label: '📸 Frame Extractor', q: 'frame' },
  { label: '🪪 ID Photo Sizer', q: 'id photo' },
  { label: '🏠 Mortgage Prepayment', q: 'mortgage' },
  { label: '🚗 Auto Loan APR & EV TCO', q: 'auto loan' },
  { label: '📈 FIRE Retirement', q: 'fire' },
  { label: '🏁 QR Code Studio', q: 'qr' },
  { label: '🏷️ Bulk Barcode A4', q: 'barcode' },
  { label: '📄 Local PDF Toolkit', q: 'pdf' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title={`Privacy-First Online Tools (${TOOLS.length} Utilities): Video to GIF, Financial Calculators, QR/Barcode & Labs · ${SITE.titleEn}`}
      description={SITE.descriptionEn}
      alternateZh="/tools/"
      alternateEn="/en/tools/"
    />
  </head>
  <body>
    <Header lang="en" switchLangUrl="/tools/" />
    <BodyWrapper>
      <header class="tools-banner">
        <div class="banner-top">
          <div class="banner-badges">
            <span class="wasm-tag">⚡ 100% Client-Side · Zero Server Uploads</span>
            <span class="count-tag">📦 {TOOLS.length} Free Tools · 6 Categories</span>
          </div>
          <a href="/tools/" class="lang-link">🌐 切换到中文版 →</a>
        </div>
        <h1 class="tools-title">🛠️ Privacy-First Online Tools & Engineering Labs</h1>
        <p class="tools-subtitle">
          Every video converter, image studio, financial calculator, QR/barcode generator, and source-code sandbox runs <strong>100% locally in your browser</strong> powered by WebCodecs hardware acceleration and micro Rust WebAssembly. Zero uploads, zero watermarks.
        </p>

        <div class="directory-controls">
          <div class="search-box-wrap">
            <span class="search-icon" aria-hidden="true">🔍</span>
            <input
              id="tool-search-input"
              type="search"
              class="tool-search-input"
              placeholder="Search tools by name or keyword (e.g. video to gif, mortgage, apr, qr code, barcode, pdf, token...)"
              autocomplete="off"
            />
            <button id="tool-search-clear" type="button" class="search-clear-btn" hidden>Clear</button>
          </div>

          <div class="hot-tags-bar">
            <span class="hot-label">Popular:</span>
            {hotKeywordsEn.map((hk) => (
              <button type="button" class="hot-tag-btn" data-query={hk.q}>
                {hk.label}
              </button>
            ))}
          </div>

          <nav class="category-tabs" aria-label="Tool Category Filter">
            <button type="button" class="cat-tab is-active" data-group="all">
              <span>✨ All Tools</span>
              <span class="cat-count">{TOOLS.length}</span>
            </button>
            {TOOL_CATEGORIES.map((cat) => {
              const items = getToolsByGroup(cat.id);
              return (
                <button type="button" class="cat-tab" data-group={cat.id}>
                  <span>{cat.icon} {cat.shortTitleEn}</span>
                  <span class="cat-count">{items.length}</span>
                </button>
              );
            })}
          </nav>
        </div>
      </header>

      <div id="empty-search-state" class="empty-search-box" hidden>
        <p class="empty-title">🙈 No matching tools found</p>
        <p class="empty-sub">Try another keyword (e.g. "GIF", "loan", "QR", "PDF") or reset the filter below.</p>
        <button id="reset-filter-btn" type="button" class="reset-btn">Show All {TOOLS.length} Tools</button>
      </div>

      {TOOL_CATEGORIES.map((cat) => {
        const groupTools = getToolsByGroup(cat.id);
        return (
          <section
            id={cat.id === 'principle-lab' ? 'labs' : cat.id}
            data-section-group={cat.id}
            class="category-section"
          >
            <div class="section-heading">
              <div class="heading-left">
                <h2 class="section-title">{cat.titleEn}</h2>
                <p class="section-desc">{cat.descriptionEn}</p>
              </div>
              <span class="section-count-pill">{groupTools.length} Tools</span>
            </div>

            <div class="tools-grid">
              {groupTools.map((tool) => {
                const searchCorpus = [
                  tool.titleEn,
                  tool.descriptionEn,
                  tool.badgeEn,
                  tool.title,
                  ...(tool.keywords || []),
                ]
                  .join(' ')
                  .toLowerCase();

                return (
                  <div
                    class={`tool-card ${tool.section === 'lab' ? 'lab-card' : ''} ${tool.status === 'coming-soon' ? 'is-upcoming' : ''}`}
                    data-tool-card
                    data-tool-group={cat.id}
                    data-search={searchCorpus}
                  >
                    <a href={tool.pathEn} class="card-main-link">
                      <div class="card-meta">
                        <span class={`status-badge ${tool.status}`}>{tool.badgeEn}</span>
                        {tool.wasmPowered ? (
                          <span class="engine-badge is-wasm">⚡ Rust Wasm</span>
                        ) : (
                          <span class="engine-badge">🔒 100% Local</span>
                        )}
                      </div>
                      <h3 class="card-title">{tool.titleEn}</h3>
                      <p class="card-desc">{tool.descriptionEn}</p>
                    </a>
                    {tool.relatedPosts && tool.relatedPosts.length > 0 && (
                      <div class="related-post-bar">
                        <span class="related-label">📖 Companion Deep-Dive Article:</span>
                        <div class="related-links">
                          {tool.relatedPosts.map((post) => (
                            <a href={post.url} class="related-link">{post.titleEn}</a>
                          ))}
                        </div>
                      </div>
                    )}
                    <div class="card-footer">
                      <a href={tool.pathEn} class="enter-text">
                        {tool.section === 'lab'
                          ? 'Launch Interactive Lab →'
                          : tool.status === 'live'
                            ? 'Launch Tool →'
                            : 'Coming Soon'}
                      </a>
                    </div>
                  </div>
                );
              })}
            </div>
          </section>
        );
      })}

      <AdSlot lang="en" category="ai-cost" position="bottom" />
    </BodyWrapper>
    <Footer />

    <script is:inline data-astro-rerun>
      (function () {
        const searchInput = document.getElementById('tool-search-input');
        const clearBtn = document.getElementById('tool-search-clear');
        const resetBtn = document.getElementById('reset-filter-btn');
        const emptyState = document.getElementById('empty-search-state');
        const tabBtns = Array.from(document.querySelectorAll('.cat-tab'));
        const hotBtns = Array.from(document.querySelectorAll('.hot-tag-btn'));
        const sections = Array.from(document.querySelectorAll('[data-section-group]'));

        let activeGroup = 'all';
        let query = '';

        function applyFilters() {
          const cleanQuery = query.trim().toLowerCase();
          if (clearBtn) {
            clearBtn.hidden = cleanQuery.length === 0;
          }

          tabBtns.forEach((btn) => {
            const g = btn.getAttribute('data-group');
            btn.classList.toggle('is-active', g === activeGroup);
          });

          let totalVisible = 0;

          sections.forEach((sec) => {
            const secGroup = sec.getAttribute('data-section-group');
            const groupMatches = activeGroup === 'all' || activeGroup === secGroup;
            if (!groupMatches) {
              sec.hidden = true;
              return;
            }

            const secCards = Array.from(sec.querySelectorAll('[data-tool-card]'));
            let visibleInSec = 0;
            secCards.forEach((card) => {
              const corpus = card.getAttribute('data-search') || '';
              const textMatches = !cleanQuery || corpus.includes(cleanQuery);
              card.hidden = !textMatches;
              if (textMatches) {
                visibleInSec++;
                totalVisible++;
              }
            });

            sec.hidden = visibleInSec === 0;
          });

          if (emptyState) {
            emptyState.hidden = totalVisible > 0;
          }
        }

        function syncFromHash() {
          const rawHash = (window.location.hash || '').replace(/^#/, '');
          if (!rawHash) return;
          const mapped = rawHash === 'labs' ? 'principle-lab' : rawHash;
          const validGroups = ['all', 'media', 'calculator', 'daily-qr', 'creator-biz', 'dev-ai-web3', 'principle-lab'];
          if (validGroups.includes(mapped)) {
            activeGroup = mapped;
            applyFilters();
          }
        }

        tabBtns.forEach((btn) => {
          btn.addEventListener('click', () => {
            const g = btn.getAttribute('data-group') || 'all';
            activeGroup = g;
            if (g === 'all') {
              history.replaceState(null, '', window.location.pathname);
            } else {
              history.replaceState(null, '', '#' + (g === 'principle-lab' ? 'labs' : g));
            }
            applyFilters();
          });
        });

        hotBtns.forEach((btn) => {
          btn.addEventListener('click', () => {
            const q = btn.getAttribute('data-query') || '';
            if (searchInput) {
              searchInput.value = q;
            }
            activeGroup = 'all';
            query = q;
            applyFilters();
          });
        });

        if (searchInput) {
          searchInput.addEventListener('input', (e) => {
            query = e.target.value || '';
            applyFilters();
          });
        }

        if (clearBtn) {
          clearBtn.addEventListener('click', () => {
            query = '';
            if (searchInput) searchInput.value = '';
            applyFilters();
          });
        }

        if (resetBtn) {
          resetBtn.addEventListener('click', () => {
            query = '';
            activeGroup = 'all';
            if (searchInput) searchInput.value = '';
            history.replaceState(null, '', window.location.pathname);
            applyFilters();
          });
        }

        window.addEventListener('hashchange', syncFromHash);
        syncFromHash();
      })();
    </script>
  </body>
</html>

<style lang="less">
  .tools-banner {
    margin-bottom: 24px;
    padding: 24px 28px;
    border-radius: 16px;
    background: var(--author-banner);
    border: 1px solid var(--border-color);

    @media (max-width: 640px) {
      padding: 16px 14px;
      border-radius: 12px;
      margin-bottom: 18px;
    }
  }

  .banner-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 10px;
    flex-wrap: wrap;
    gap: 8px;
  }

  .banner-badges {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px;
  }

  .wasm-tag {
    display: inline-flex;
    align-items: center;
    padding: 3px 10px;
    border-radius: 999px;
    font-size: 12px;
    font-weight: 700;
    background-color: var(--accent-soft);
    color: var(--accent);
    border: 1px solid var(--accent-border);
  }

  .count-tag {
    display: inline-flex;
    align-items: center;
    padding: 3px 10px;
    border-radius: 999px;
    font-size: 12px;
    font-weight: 700;
    background-color: var(--bg-surface);
    color: var(--text-secondary);
    border: 1px solid var(--border-color);
  }

  .lang-link {
    font-size: 13px;
    font-weight: 600;
    color: var(--accent);
    text-decoration: none;

    &:hover {
      text-decoration: underline;
    }
  }

  .tools-title {
    margin: 0 0 8px;
    font-size: 24px;
    font-weight: 800;
    color: var(--text-primary);
  }

  .tools-subtitle {
    margin: 0 0 18px;
    font-size: 14px;
    color: var(--text-secondary);
    line-height: 1.65;
  }

  .directory-controls {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding-top: 14px;
    border-top: 1px dashed var(--border-color);
  }

  .search-box-wrap {
    position: relative;
    display: flex;
    align-items: center;
  }

  .search-icon {
    position: absolute;
    left: 14px;
    font-size: 15px;
    pointer-events: none;
  }

  .tool-search-input {
    width: 100%;
    padding: 11px 70px 11px 40px;
    border-radius: 12px;
    border: 1px solid var(--border-color);
    background-color: var(--bg-surface);
    color: var(--text-primary);
    font-size: 14px;
    outline: none;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;

    &:focus {
      border-color: var(--accent);
      box-shadow: 0 0 0 3px var(--accent-soft);
    }
  }

  .search-clear-btn {
    position: absolute;
    right: 10px;
    padding: 4px 10px;
    border-radius: 8px;
    border: 1px solid var(--border-color);
    background-color: var(--bg-muted);
    color: var(--text-secondary);
    font-size: 12px;
    font-weight: 600;
    cursor: pointer;

    &:hover {
      color: var(--accent);
      border-color: var(--accent-border);
    }
  }

  .hot-tags-bar {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 6px;
    font-size: 12px;
  }

  .hot-label {
    font-weight: 700;
    color: var(--text-muted);
  }

  .hot-tag-btn {
    padding: 3px 9px;
    border-radius: 999px;
    border: 1px solid var(--border-subtle);
    background-color: var(--bg-surface);
    color: var(--text-secondary);
    font-size: 12px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.18s ease;

    &:hover {
      border-color: var(--accent-border);
      color: var(--accent);
      background-color: var(--accent-soft);
    }
  }

  .category-tabs {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px;
    padding-top: 2px;
  }

  .cat-tab {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 7px 13px;
    border-radius: 999px;
    border: 1px solid var(--border-color);
    background-color: var(--bg-surface);
    color: var(--text-secondary);
    font-size: 13px;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.2s ease;

    &:hover {
      border-color: var(--accent-border);
      color: var(--accent);
      transform: translateY(-1px);
    }

    &.is-active {
      background-color: var(--accent);
      border-color: var(--accent);
      color: #fff;

      .cat-count {
        background-color: rgba(255, 255, 255, 0.22);
        color: #fff;
      }
    }
  }

  .cat-count {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 20px;
    height: 18px;
    padding: 0 6px;
    border-radius: 999px;
    font-size: 11px;
    font-weight: 800;
    background-color: var(--bg-muted);
    color: var(--text-muted);
  }

  .empty-search-box {
    margin: 24px 0;
    padding: 36px 20px;
    border-radius: 16px;
    border: 1px dashed var(--border-color);
    background-color: var(--bg-surface);
    text-align: center;
  }

  .empty-title {
    margin: 0 0 6px;
    font-size: 17px;
    font-weight: 800;
    color: var(--text-primary);
  }

  .empty-sub {
    margin: 0 0 14px;
    font-size: 13.5px;
    color: var(--text-secondary);
  }

  .reset-btn {
    padding: 8px 16px;
    border-radius: 10px;
    border: 1px solid var(--accent-border);
    background-color: var(--accent-soft);
    color: var(--accent);
    font-size: 13px;
    font-weight: 700;
    cursor: pointer;
  }

  .category-section {
    margin-bottom: 30px;
    scroll-margin-top: 84px;
  }

  .section-heading {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 10px;
    margin: 8px 0 14px;
    padding-bottom: 10px;
    border-bottom: 1px dashed var(--border-color);
  }

  .heading-left {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .section-title {
    margin: 0;
    font-size: 19px;
    font-weight: 800;
    color: var(--text-primary);
  }

  .section-desc {
    margin: 0;
    font-size: 13px;
    color: var(--text-muted);
    line-height: 1.5;
  }

  .section-count-pill {
    padding: 3px 10px;
    border-radius: 999px;
    font-size: 12px;
    font-weight: 700;
    background-color: var(--bg-muted);
    color: var(--text-secondary);
    border: 1px solid var(--border-subtle);
    white-space: nowrap;
  }

  .tools-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 16px;

    @media (max-width: 820px) {
      grid-template-columns: 1fr;
    }
  }

  .tool-card {
    display: flex;
    flex-direction: column;
    padding: 20px 22px;
    border-radius: 16px;
    background-color: var(--bg-surface);
    border: 1px solid var(--border-color);
    text-decoration: none;
    transition: all 0.22s ease;
    min-width: 0;

    &[hidden] {
      display: none !important;
    }

    @media (max-width: 640px) {
      padding: 16px 14px;
      border-radius: 12px;
    }

    &:hover {
      border-color: var(--accent-border);
      transform: translateY(-2px);
      box-shadow: var(--shadow-md);
    }

    &.is-upcoming {
      opacity: 0.78;
    }
  }

  .card-main-link {
    text-decoration: none;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .card-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    margin-bottom: 10px;
  }

  .status-badge {
    font-size: 11.5px;
    font-weight: 700;
    padding: 3px 10px;
    border-radius: 999px;
    background-color: var(--accent-soft);
    color: var(--accent);

    &.coming-soon {
      background-color: var(--bg-muted);
      color: var(--text-muted);
    }
  }

  .engine-badge {
    font-size: 11px;
    font-weight: 600;
    color: var(--text-muted);
    font-family: monospace;

    &.is-wasm {
      color: var(--accent);
    }
  }

  .card-title {
    margin: 0 0 8px;
    font-size: 16.5px;
    font-weight: 700;
    color: var(--text-primary);
    line-height: 1.4;
  }

  .card-desc {
    margin: 0 0 12px;
    font-size: 13.5px;
    color: var(--text-secondary);
    line-height: 1.6;
    flex: 1;
  }

  .related-post-bar {
    margin-bottom: 12px;
    padding: 10px 12px;
    border-radius: 10px;
    background-color: var(--bg-muted);
    border: 1px solid var(--border-subtle);
    font-size: 12px;
  }

  .related-label {
    font-weight: 700;
    color: var(--text-secondary);
    display: block;
    margin-bottom: 4px;
  }

  .related-links {
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  .related-link {
    color: var(--accent);
    text-decoration: none;
    font-weight: 600;
    line-height: 1.4;

    &:hover {
      text-decoration: underline;
    }
  }

  .card-footer {
    padding-top: 10px;
    border-top: 1px dashed var(--border-color);
  }

  .enter-text {
    font-size: 13px;
    font-weight: 700;
    color: var(--accent);
    text-decoration: none;
  }
</style>
