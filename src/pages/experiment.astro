---
import BaseHead from '@/components/BaseHead.astro';
import { SITE } from '@/consts';
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <BaseHead title={`交互式原理实验室 · ${SITE.title}`} description={SITE.description} />
    <link rel="canonical" href="https://yunsin.top/tools/#labs" />
    <meta http-equiv="refresh" content="0;url=/tools/#labs" />
    <script is:inline>
      window.location.replace('/tools/#labs');
    </script>
  </head>
  <body>
    <p style="padding: 2rem; text-align: center;">
      正在前往极客工具箱 · 底层原理交互实验室：<a href="/tools/#labs">/tools/#labs</a>
    </p>
  </body>
</html>
