---
import BaseHead from '@/components/BaseHead.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import { SITE, TOOLS, TOOL_CATEGORIES } from '@/consts';
import BodyWrapper from '@/components/BodyWrapper.astro';
import ArticleList from '@/components/ArticleList.astro';
import Author from '@/components/Author.astro';
import Card from '@/components/Card.astro';
import CardTitle from '@/components/CardTitle.astro';
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={SITE.title} image={SITE.logo} description={SITE.description} />
	</head>
	<body>
		<Header />
		<BodyWrapper class="home-layout">
      <aside class="home-sidebar">
        <Author />
        <Card class="stat-card">
          <CardTitle>🛠️ 在线工具箱 ({TOOLS.length}款)</CardTitle>
          <div class="tools-cat-pills">
            {TOOL_CATEGORIES.map((cat) => (
              <a href={`/tools/#${cat.id === 'principle-lab' ? 'labs' : cat.id}`} class="cat-mini-pill">
                <span>{cat.icon}</span>
                <span>{cat.shortTitle}</span>
              </a>
            ))}
          </div>
          <div class="tools-mini-list">
            {[TOOLS[0], TOOLS[8], TOOLS[14], TOOLS[28]].filter(Boolean).map((tool) => (
              <a href={tool.pathZh} class="tool-mini-item">
                <div class="tool-mini-top">
                  <span class="tool-mini-badge">{tool.badge}</span>
                </div>
                <div class="tool-mini-title">{tool.title}</div>
              </a>
            ))}
            <a href="/tools/" class="tool-more-link">查看全部 6 大分类 ({TOOLS.length} 项) →</a>
          </div>
        </Card>
        <Card class="about-card">
          <CardTitle>关于本站</CardTitle>
          <div class="about-content">
            <p>本站是一个基于 <strong>Astro + Vue 3 + Rust WebAssembly</strong> 构建的静态技术博客与在线工具站。</p>
            <p>所有在线小工具均在您的浏览器本地执行，<strong>零上传、保护隐私</strong>，文章评论使用 <a class="inline-link" href="https://giscus.app/" target="_blank">Giscus</a>。</p>
            <div class="badge-wrap">
              <a href="https://http3.wcode.net/?q=yunsin.top" target="_blank" rel="noopener noreferrer">
                <img src="https://http3.wcode.net/badges/http3.svg?host=yunsin.top" alt="HTTP/3 Status" style="max-width: 100%; height: 20px; margin: 0;" />
              </a>
            </div>
          </div>
        </Card>
      </aside>
			<section class="home-main">
        <ArticleList />
			</section>
		</BodyWrapper>
		<Footer />
	</body>
</html>

<style lang="less">
  :global(.home-layout) {
    display: flex;
    align-items: flex-start;
    gap: 24px;
  }

  .home-sidebar {
    width: 288px;
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
    gap: 16px;
    position: sticky;
    top: 82px;
  }

  .home-main {
    flex: 1;
    min-width: 0;
  }

  .tools-cat-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    padding-top: 10px;
  }

  .cat-mini-pill {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 3px 8px;
    border-radius: 999px;
    font-size: 11px;
    font-weight: 600;
    background-color: var(--bg-muted);
    border: 1px solid var(--border-subtle);
    color: var(--text-secondary);
    text-decoration: none;
    transition: all 0.2s ease;

    &:hover {
      border-color: var(--accent-border);
      color: var(--accent);
      background-color: var(--accent-soft);
    }
  }

  .tools-mini-list {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding-top: 12px;
  }

  .tool-mini-item {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 10px 12px;
    border-radius: 10px;
    background-color: var(--bg-muted);
    border: 1px solid var(--border-subtle);
    text-decoration: none;
    transition: all 0.2s ease;

    &:hover {
      border-color: var(--accent-border);
      background-color: var(--accent-soft);
      transform: translateY(-1px);
    }
  }

  .tool-mini-badge {
    font-size: 11px;
    font-weight: 600;
    color: var(--accent);
  }

  .tool-mini-title {
    font-size: 13px;
    font-weight: 600;
    color: var(--text-primary);
    line-height: 1.4;
  }

  .tool-more-link {
    font-size: 12px;
    font-weight: 600;
    color: var(--accent);
    text-align: center;
    padding-top: 4px;
    text-decoration: none;

    &:hover {
      text-decoration: underline;
    }
  }

  .about-content {
    padding-top: 12px;
    font-size: 13px;
    line-height: 1.7;
    color: var(--text-secondary);

    p {
      margin: 0 0 8px;
    }

    strong {
      color: var(--text-primary);
      font-weight: 600;
    }
  }

  .inline-link {
    color: var(--accent);
    text-decoration: none;
    font-weight: 500;
    &:hover {
      text-decoration: underline;
    }
  }

  .badge-wrap {
    display: flex;
    justify-content: center;
    padding-top: 8px;
  }

  @media (max-width: 1024px) {
    :global(.home-layout) {
      flex-direction: column;
      gap: 20px;
    }

    .home-sidebar {
      width: 100%;
      position: static;
      display: grid;
      grid-template-columns: 1.2fr 1fr;
      gap: 16px;

      :global(.author-card) {
        grid-row: span 2;
      }
    }

    .home-main {
      width: 100%;
    }
  }

  @media (max-width: 680px) {
    .home-sidebar {
      grid-template-columns: 1fr;
      gap: 12px;

      :global(.author-card) {
        grid-row: auto;
      }
    }
  }
</style>
