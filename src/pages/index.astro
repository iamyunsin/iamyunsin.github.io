---
import BaseHead from '@/components/BaseHead.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import { SITE } from '@/consts';
import BodyWrapper from '@/components/BodyWrapper.astro';
import ArticleList from '@/components/ArticleList.astro';
import Author from '@/components/Author.astro';
import Card from '@/components/Card.astro';
import CardTitle from '@/components/CardTitle.astro';
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={SITE.title} image={SITE.logo} description={SITE.description} />
	</head>
	<body>
		<Header />
		<BodyWrapper class="home-layout">
      <aside class="home-sidebar">
        <Author />
        <Card class="stat-card">
          <CardTitle>统计数据</CardTitle>
          <div class="stats-grid">
            <div class="stat-item">
              <span class="stat-value" data-sinsuan-site-uv></span>
              <span class="stat-label">访客数 (UV)</span>
            </div>
            <div class="stat-item">
              <span class="stat-value" data-sinsuan-site-pv></span>
              <span class="stat-label">访问量 (PV)</span>
            </div>
          </div>
        </Card>
        <Card class="about-card">
          <CardTitle>关于本站</CardTitle>
          <div class="about-content">
            <p>本站是一个基于 <strong>Astro</strong> 构建的纯静态技术博客，使用 GitHub Actions + GitHub Pages / Nginx 自动化部署。</p>
            <p>站点统计使用<strong>最新自研</strong>的 <a class="inline-link" href="/blog/knowledge/sinsuan/" target="_blank">心算</a>，文章评论使用 <a class="inline-link" href="https://giscus.app/" target="_blank">Giscus</a>。</p>
            <div class="badge-wrap">
              <a href="https://http3.wcode.net/?q=yunsin.top" target="_blank" rel="noopener noreferrer">
                <img src="https://http3.wcode.net/badges/http3.svg?host=yunsin.top" alt="HTTP/3 Status" style="max-width: 100%; height: 20px; margin: 0;" />
              </a>
            </div>
          </div>
        </Card>
      </aside>
			<section class="home-main">
        <ArticleList />
			</section>
		</BodyWrapper>
		<Footer />
	</body>
</html>

<style lang="less">
  :global(.home-layout) {
    display: flex;
    align-items: flex-start;
    gap: 24px;
  }

  .home-sidebar {
    width: 288px;
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
    gap: 16px;
    position: sticky;
    top: 82px;
  }

  .home-main {
    flex: 1;
    min-width: 0;
  }

  .stats-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 10px;
    padding-top: 14px;
  }

  .stat-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 12px 8px;
    border-radius: 10px;
    background-color: var(--bg-muted);
    border: 1px solid var(--border-subtle);
  }

  .stat-value {
    font-size: 18px;
    font-weight: 700;
    color: var(--accent-secondary);
    font-variant-numeric: tabular-nums;
    min-height: 24px;
    display: inline-flex;
    align-items: center;

    &:empty::before {
      content: '—';
      color: var(--text-muted);
      font-weight: 500;
    }
  }

  .stat-label {
    font-size: 12px;
    color: var(--text-muted);
    margin-top: 4px;
  }

  .about-content {
    padding-top: 12px;
    font-size: 13px;
    line-height: 1.7;
    color: var(--text-secondary);

    p {
      margin: 0 0 8px;
    }

    strong {
      color: var(--text-primary);
      font-weight: 600;
    }
  }

  .inline-link {
    color: var(--accent);
    text-decoration: none;
    font-weight: 500;
    &:hover {
      text-decoration: underline;
    }
  }

  .badge-wrap {
    display: flex;
    justify-content: center;
    padding-top: 8px;
  }

  @media (max-width: 1024px) {
    :global(.home-layout) {
      flex-direction: column;
      gap: 20px;
    }

    .home-sidebar {
      width: 100%;
      position: static;
      display: grid;
      grid-template-columns: 1.2fr 1fr;
      gap: 16px;

      :global(.author-card) {
        grid-row: span 2;
      }
    }

    .home-main {
      width: 100%;
    }
  }

  @media (max-width: 680px) {
    .home-sidebar {
      grid-template-columns: 1fr;
      gap: 12px;

      :global(.author-card) {
        grid-row: auto;
      }
    }
  }
</style>
