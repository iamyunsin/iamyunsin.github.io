---
import BaseHead from '@/components/BaseHead.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import BodyWrapper from '@/components/BodyWrapper.astro';
import AdSlot from '@/components/tools/AdSlot.astro';
import AffiliateCard, { type AffiliateOffer } from '@/components/tools/AffiliateCard.astro';
import { SITE, TOOLS, getCategoryMeta, getToolsByGroup } from '@/consts';
import {
  TOOL_SEO_OVERRIDES,
  getPresetsForParentTool,
  getSchemaApplicationCategory,
} from '@/data/seoPresets';

export interface FaqItem {
  question: string;
  answer: string;
}

interface Props {
  title: string;
  seoTitle?: string;
  description: string;
  keywords?: string[];
  parentToolSlug?: string;
  lang: 'zh' | 'en';
  category: 'ai-cost' | 'media-doc' | 'dev-network' | 'web3';
  alternateZh: string;
  alternateEn: string;
  wasmSizeLabel?: string;
  offers?: AffiliateOffer[];
  faqs?: FaqItem[];
}

const {
  title,
  seoTitle,
  description,
  keywords = [],
  parentToolSlug,
  lang = 'zh',
  category,
  alternateZh,
  alternateEn,
  wasmSizeLabel = '28 KB Rust Wasm',
  offers = [],
  faqs = [],
} = Astro.props;

const baseSite = Astro.site || SITE.domain;
const switchLangUrl = lang === 'en' ? alternateZh : alternateEn;
const canonicalUrl = new URL(Astro.url.pathname, baseSite).toString();
const matchedTool = parentToolSlug
  ? TOOLS.find((t) => t.slug === parentToolSlug)
  : TOOLS.find((t) => t.pathZh === alternateZh || t.pathEn === alternateEn);
const relatedPosts = matchedTool?.relatedPosts || [];
const currentGroup = matchedTool?.group || 'media';
const categoryMeta = getCategoryMeta(currentGroup);
const siblingTools = getToolsByGroup(currentGroup);
const otherSiblingTools = siblingTools.filter((t) => t.slug !== matchedTool?.slug);

// 匹配存量工具 SEO 意图词增强表与子场景专页内链矩阵
const seoOverride = !parentToolSlug && matchedTool ? TOOL_SEO_OVERRIDES[matchedTool.slug] : undefined;
const effectiveMetaTitle =
  seoTitle ||
  (lang === 'en' ? seoOverride?.seoTitleEn : seoOverride?.seoTitleZh) ||
  `${title} | ${lang === 'en' ? SITE.titleEn : SITE.title}`;
const effectiveMetaDesc =
  (lang === 'en' ? seoOverride?.seoDescEn : seoOverride?.seoDescZh) || description;
const effectiveOgImage = lang === 'en' ? SITE.toolsOgImageEn : SITE.toolsOgImageZh;

const effectiveKeywords = [
  ...keywords,
  ...(matchedTool?.keywords || []),
  ...((lang === 'en' ? seoOverride?.extraKeywordsEn : seoOverride?.extraKeywordsZh) || []),
];

const relatedPresets = matchedTool ? getPresetsForParentTool(matchedTool.slug) : [];
const schemaAppCategory = getSchemaApplicationCategory(currentGroup);

// BreadcrumbList Schema (3-level for standard tool, 4-level for pSEO preset page)
const breadcrumbItems: Record<string, any>[] = [
  {
    '@type': 'ListItem',
    position: 1,
    name: lang === 'en' ? 'Home' : '首页',
    item: new URL('/', baseSite).toString(),
  },
  {
    '@type': 'ListItem',
    position: 2,
    name: lang === 'en' ? 'Online Tools' : '在线工具箱',
    item: new URL(lang === 'en' ? '/en/tools/' : '/tools/', baseSite).toString(),
  },
];

if (parentToolSlug && matchedTool) {
  breadcrumbItems.push({
    '@type': 'ListItem',
    position: 3,
    name: lang === 'en' ? matchedTool.titleEn : matchedTool.title,
    item: new URL(lang === 'en' ? matchedTool.pathEn : matchedTool.pathZh, baseSite).toString(),
  });
  breadcrumbItems.push({
    '@type': 'ListItem',
    position: 4,
    name: title,
    item: canonicalUrl,
  });
} else {
  breadcrumbItems.push({
    '@type': 'ListItem',
    position: 3,
    name: title,
    item: canonicalUrl,
  });
}

// Automatic WebApplication + BreadcrumbList + FAQPage JSON-LD Schema for Rich Snippets
const jsonLdSchemas: Record<string, any>[] = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: title,
    description: effectiveMetaDesc,
    url: canonicalUrl,
    image: new URL(effectiveOgImage, baseSite).toString(),
    applicationCategory: schemaAppCategory,
    operatingSystem: 'All',
    browserRequirements: 'Requires HTML5 / JavaScript',
    isAccessibleForFree: true,
    inLanguage: lang === 'en' ? 'en' : 'zh-CN',
    offers: {
      '@type': 'Offer',
      price: '0',
      priceCurrency: 'USD',
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: breadcrumbItems,
  },
];

if (faqs.length > 0) {
  jsonLdSchemas.push({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({
      '@type': 'Question',
      name: f.question,
      acceptedAnswer: {
        '@type': 'Answer',
        text: f.answer,
      },
    })),
  });
}

interface ParsedFaqBlock {
  badge?: string;
  lead?: string;
  html: string;
}

function escapeHtml(raw: string): string {
  return raw
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;');
}

function highlightInlineTech(text: string): string {
  let safe = escapeHtml(text);

  // Highlight inline code expressions, parenthetical assignments/bitwise ops, CLI/API names, and Big-O notation
  const codePattern =
    /(\{\{[^}]+\}\}|`[^`]+`|\bO\([^)]+\)|_hoisted_\d+|_cache\[\d+\]|render\([^)]*\)|\b[a-zA-Z_][a-zA-Z0-9_]*\(\)|(?<=^|[\s(（])(?::[a-zA-Z-]+|@[a-zA-Z-]+)|\bv-[a-zA-Z-]+|\b(?:TEXT|CLASS|STYLE|PROPS|FULL_PROPS|STABLE_FRAGMENT|KEYED_FRAGMENT|HOISTED)\s*=\s*-?\d+|\bflag\s*\|=\s*[A-Z_]+|\bpatchFlag\s*&amp;\s*[A-Za-z._]+|\bPatchFlag\s*=\s*-?\d+|\b(?:baseParse|transform|generate|hoistStatic|PatchFlags|PatchFlag|Block Tree|Template AST|JS AST|VNode|DOM|HTML|codegenNode|patchElement|patchKeyedChildren|getSequence|dynamicChildren|newIndexToOldIndexMap|targetMap|depsMap|ReactiveEffect|WeakMap|Promise\.then|queueMicrotask|MutationObserver|requestAnimationFrame|requestIdleCallback|setTimeout|setInterval|0-RTT|1-RTT|2-RTT|HTTP\/3|HTTP\/2|HTTP\/1\.1|QUIC|TLS 1\.3|TCP|UDP|AASA|apple-app-site-association|assetlinks\.json|visibilitychange|document\.hidden|MicroMessenger|o200k_base|DeepSeek-V3\/R1|DeepSeek-R1|GPT-4o|Claude 3\.7 Sonnet|WebP|AVIF|0xFFE1|APP1)\b)/g;

  safe = safe.replace(codePattern, (match) => {
    const clean = match.startsWith('`') && match.endsWith('`') ? match.slice(1, -1) : match;
    return `<code class="faq-inline-code">${clean}</code>`;
  });

  // Highlight quoted key concepts “...”
  safe = safe.replace(/“([^”]+)”/g, '<strong class="faq-quote">“$1”</strong>');

  return safe;
}

function parseFaqAnswer(answer: string): { intro?: string; blocks: ParsedFaqBlock[] } {
  const trimmed = answer.trim();

  // Case 1: Numbered list items like "1. xxx；2. xxx；3. xxx" or "1. xxx 2. xxx"
  if (/(?:^|[；;。]\s*)1\.\s*/.test(trimmed)) {
    const firstOneIdx = trimmed.search(/1\.\s*/);
    const intro = firstOneIdx > 0 ? trimmed.slice(0, firstOneIdx).replace(/[：:；;]\s*$/, '').trim() : undefined;
    const rest = firstOneIdx > 0 ? trimmed.slice(firstOneIdx) : trimmed;
    const rawItems = rest
      .split(/(?:[；;。]\s*|\s+)(?=\d+\.\s*)/)
      .map((s) => s.trim())
      .filter(Boolean);

    const blocks: ParsedFaqBlock[] = rawItems.map((item, idx) => {
      const withoutNum = item.replace(/^\d+\.\s*/, '').replace(/[；;。]+$/, '');
      const colonIdx = withoutNum.search(/[：:]/);
      if (colonIdx > 0 && colonIdx < 28) {
        const lead = withoutNum.slice(0, colonIdx).trim();
        const body = withoutNum.slice(colonIdx + 1).trim();
        return {
          badge: `0${idx + 1}`,
          lead: highlightInlineTech(lead),
          html: highlightInlineTech(body),
        };
      }
      return {
        badge: `0${idx + 1}`,
        html: highlightInlineTech(withoutNum),
      };
    });

    return { intro: intro ? highlightInlineTech(intro) : undefined, blocks };
  }

  // Case 2: Chinese ordinal clauses "第一，...；第二，...；第三，..."
  if (/第一[，、]/.test(trimmed)) {
    const firstIdx = trimmed.search(/第一[，、]/);
    const intro = firstIdx > 0 ? trimmed.slice(0, firstIdx).replace(/[：:；;]\s*$/, '').trim() : undefined;
    const rest = firstIdx > 0 ? trimmed.slice(firstIdx) : trimmed;
    const parts = rest
      .split(/[；;。]\s*(?=第[一二三四五][，、])/)
      .map((s) => s.trim())
      .filter(Boolean);

    const blocks: ParsedFaqBlock[] = parts.map((item, idx) => {
      const body = item.replace(/^第[一二三四五][，、]\s*/, '');
      return {
        badge: `0${idx + 1}`,
        html: highlightInlineTech(body),
      };
    });

    return { intro: intro ? highlightInlineTech(intro) : undefined, blocks };
  }

  // Case 3: Multi-sentence / semicolon explanation -> split into clean digestible points if >= 2 sentences
  const sentences = trimmed
    .split(/(?<=[。！？；])\s*(?=[A-Za-z0-9\u4e00-\u9fa5])/)
    .map((s) => s.trim())
    .filter(Boolean);

  if (sentences.length >= 2) {
    const blocks: ParsedFaqBlock[] = sentences.map((s) => {
      const cleanS = s.replace(/[；;]+$/, '。');
      const colonIdx = cleanS.search(/[：:]/);
      if (colonIdx > 0 && colonIdx < 22) {
        return {
          badge: '•',
          lead: highlightInlineTech(cleanS.slice(0, colonIdx).trim()),
          html: highlightInlineTech(cleanS.slice(colonIdx + 1).trim()),
        };
      }
      return {
        badge: '•',
        html: highlightInlineTech(cleanS),
      };
    });
    return { blocks };
  }

  return {
    blocks: [{ html: highlightInlineTech(trimmed) }],
  };
}
---

<!doctype html>
<html lang={lang === 'en' ? 'en' : 'zh-CN'}>
  <head>
    <BaseHead
      title={effectiveMetaTitle}
      description={effectiveMetaDesc}
      image={effectiveOgImage}
      keywords={effectiveKeywords}
      lang={lang}
      alternateZh={alternateZh}
      alternateEn={alternateEn}
      jsonLd={jsonLdSchemas}
    />
  </head>
  <body>
    <Header lang={lang} switchLangUrl={switchLangUrl} />
    <BodyWrapper>
      <!-- Top Breadcrumb & Language Bar -->
      <nav class="tool-breadcrumb" aria-label="Breadcrumb">
        <div class="crumb-links">
          <a href={lang === 'en' ? '/en/tools/' : '/tools/'}>
            {lang === 'en' ? '🛠️ Tools Directory' : '🛠️ 工具箱大盘'}
          </a>
          {categoryMeta && (
            <>
              <span class="crumb-sep">/</span>
              <a href={`${lang === 'en' ? '/en/tools/' : '/tools/'}#${categoryMeta.id}`}>
                {categoryMeta.icon} {lang === 'en' ? categoryMeta.shortTitleEn : categoryMeta.shortTitle}
              </a>
            </>
          )}
          {parentToolSlug && matchedTool && (
            <>
              <span class="crumb-sep">/</span>
              <a href={lang === 'en' ? matchedTool.pathEn : matchedTool.pathZh}>
                {lang === 'en'
                  ? matchedTool.titleEn.split('(')[0].trim()
                  : matchedTool.title.split('（')[0].split('(')[0].trim()}
              </a>
            </>
          )}
          <span class="crumb-sep">/</span>
          <span class="crumb-current">{title}</span>
        </div>
        <div class="trust-badges">
          <span class="trust-pill wasm-pill">⚡ {wasmSizeLabel}</span>
          <span class="trust-pill privacy-pill">
            {lang === 'en' ? '🔒 100% Client-Side · No Server Upload' : '🔒 100% 浏览器本地计算 · 零上传'}
          </span>
          <a href={switchLangUrl} class="trust-pill lang-pill">
            {lang === 'en' ? '🌐 切换中文版' : '🌐 English Version'}
          </a>
        </div>
      </nav>

      <!-- Hero Section -->
      <header class="tool-hero">
        <h1 class="tool-h1">{title}</h1>
        <p class="tool-lead">{description}</p>
        {relatedPresets.length > 0 && (
          <div class="hero-related-posts">
            <span class="hero-related-label">
              {lang === 'en' ? '🎯 Pre-Configured Quick Scenarios:' : '🎯 高频细分场景直达（点开自动预设参数）：'}
            </span>
            <div class="hero-related-links">
              {parentToolSlug && matchedTool && (
                <a
                  href={lang === 'en' ? matchedTool.pathEn : matchedTool.pathZh}
                  class="hero-related-pill"
                >
                  {lang === 'en' ? '⬅️ Full Workbench' : '⬅️ 返回全功能主工作台'}
                </a>
              )}
              {relatedPresets.map((pr) => {
                const prHref = lang === 'en' ? `/en/tools/${pr.slug}/` : `/tools/${pr.slug}/`;
                const isCurrentPreset = Astro.url.pathname.replace(/\/+$/, '') === prHref.replace(/\/+$/, '');
                return (
                  <a
                    href={prHref}
                    class={`suite-pill ${isCurrentPreset ? 'is-active' : ''}`}
                    aria-current={isCurrentPreset ? 'page' : undefined}
                  >
                    <span>⚡ {lang === 'en' ? pr.shortLabelEn : pr.shortLabelZh}</span>
                  </a>
                );
              })}
            </div>
          </div>
        )}
        {relatedPosts.length > 0 && (
          <div class="hero-related-posts">
            <span class="hero-related-label">
              {lang === 'en' ? '📖 Companion Source-Code Deep-Dive:' : '📖 阅读本文配套源码精读博文：'}
            </span>
            <div class="hero-related-links">
              {relatedPosts.map((p) => (
                <a href={p.url} class="hero-related-pill">
                  {lang === 'en' ? p.titleEn : p.title} →
                </a>
              ))}
            </div>
          </div>
        )}
        {siblingTools.length > 1 && (
          <div class="hero-suite-switcher">
            <span class="suite-switcher-label">
              {categoryMeta?.icon} {lang === 'en' ? `${categoryMeta?.shortTitleEn} Suite:` : `${categoryMeta?.shortTitle}同系工具切换：`}
            </span>
            <div class="suite-switcher-pills">
              {siblingTools.map((st) => {
                const isCurrent = !parentToolSlug && st.slug === matchedTool?.slug;
                return (
                  <a
                    href={lang === 'en' ? st.pathEn : st.pathZh}
                    class={`suite-pill ${isCurrent ? 'is-active' : ''}`}
                    aria-current={isCurrent ? 'page' : undefined}
                  >
                    <span class="suite-pill-badge">{(lang === 'en' ? st.badgeEn : st.badge).split('·')[0].trim()}</span>
                    <span class="suite-pill-name">
                      {lang === 'en'
                        ? st.titleEn.split('(')[0].trim()
                        : st.title.split('（')[0].split('(')[0].trim()}
                    </span>
                  </a>
                );
              })}
            </div>
          </div>
        )}
      </header>

      <!-- Main Interactive Tool Workspace (Vue 3 + Rust Wasm) -->
      <section class="tool-workspace">
        <slot />
      </section>

      <!-- Contextual High-Converting Affiliate Offers (AdBlock-Proof) -->
      <AffiliateCard lang={lang} offers={offers} />

      <!-- Non-Intrusive Fixed Display Ad Slot -->
      <AdSlot lang={lang} category={category} position="middle" />

      <!-- Deep SEO Guide & Documentation Slot -->
      <article class="tool-seo-article">
        <slot name="seo-content" />

        {faqs.length > 0 && (
          <section class="tool-faq-section">
            <h2 class="faq-heading">
              {lang === 'en' ? 'Frequently Asked Questions (FAQ)' : '常见问题与实战解答 (FAQ)'}
            </h2>
            <div class="faq-list">
              {faqs.map((faq, idx) => {
                const parsed = parseFaqAnswer(faq.answer);
                return (
                  <details class="faq-item" open>
                    <summary class="faq-q">
                      <span class="faq-q-badge">Q{idx + 1}</span>
                      <span class="faq-q-text">{faq.question}</span>
                      <span class="faq-q-chevron" aria-hidden="true">▾</span>
                    </summary>
                    <div class="faq-body">
                      {parsed.intro && <p class="faq-intro" set:html={parsed.intro} />}
                      <div class={parsed.blocks.length > 1 ? 'faq-steps' : 'faq-single'}>
                        {parsed.blocks.map((b) => (
                          <div class="faq-step-row">
                            {b.badge && (
                              <span class={`faq-step-badge ${b.badge === '•' ? 'is-dot' : 'is-num'}`}>
                                {b.badge}
                              </span>
                            )}
                            <div class="faq-step-content">
                              {b.lead && <strong class="faq-step-lead" set:html={`${b.lead}：`} />}
                              <span class="faq-step-text" set:html={b.html} />
                            </div>
                          </div>
                        ))}
                      </div>
                    </div>
                  </details>
                );
              })}
            </div>
          </section>
        )}

        {otherSiblingTools.length > 0 && (
          <section class="related-tools-section">
            <div class="related-tools-header">
              <h2 class="related-tools-heading">
                {categoryMeta?.icon}{' '}
                {lang === 'en'
                  ? `More in ${categoryMeta?.shortTitleEn || 'Related Tools'}`
                  : `更多【${categoryMeta?.shortTitle || '同分类'}】免费在线工具推荐`}
              </h2>
              <a href={`${lang === 'en' ? '/en/tools/' : '/tools/'}#${currentGroup}`} class="related-all-link">
                {lang === 'en' ? `Browse All ${ TOOLS.length } Tools →` : `查看全部 ${ TOOLS.length } 款工具 →`}
              </a>
            </div>
            <div class="related-tools-grid">
              {otherSiblingTools.map((rt) => (
                <a href={lang === 'en' ? rt.pathEn : rt.pathZh} class="related-tool-card">
                  <div class="rt-meta">
                    <span class="rt-badge">{lang === 'en' ? rt.badgeEn : rt.badge}</span>
                    {rt.wasmPowered && <span class="rt-wasm">Rust Wasm</span>}
                  </div>
                  <h3 class="rt-title">{lang === 'en' ? rt.titleEn : rt.title}</h3>
                  <p class="rt-desc">{lang === 'en' ? rt.descriptionEn : rt.description}</p>
                </a>
              ))}
            </div>
          </section>
        )}

        <!-- Automatic Zero-Support Legal Disclaimer -->
        <footer class="tool-disclaimer">
          <p>
            {lang === 'en'
              ? '⚖️ Disclaimer: All file processing, media encoding, financial calculations, and barcode generation run 100% locally in your browser. No files, photos, or inputs are ever uploaded to or stored on any server. Financial, loan, and tax estimations are for reference only; please consult official bank or tax authorities for final figures.'
              : '⚖️ 免责声明：本工具所有音视频编解码、图像证件处理、二维码生成及财务测算均 100% 在您的浏览器本地完成，绝不向任何服务器上传或留存您的文件与隐私数据。房贷、车贷、利率与个税测算结果仅供参考，实际结算请以银行合同或税务机关官方标准为准。'}
          </p>
        </footer>
      </article>
    </BodyWrapper>
    <Footer />
  </body>
</html>

<style lang="less">
  .tool-breadcrumb {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 10px;
    margin-bottom: 14px;
    font-size: 13px;
  }

  .crumb-links {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 6px;
    min-width: 0;
    color: var(--text-muted);

    a {
      color: var(--accent);
      text-decoration: none;
      font-weight: 600;
      white-space: nowrap;

      &:hover {
        text-decoration: underline;
      }
    }
  }

  .crumb-current {
    color: var(--text-secondary);
    font-weight: 500;
    word-break: break-word;
  }

  .trust-badges {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px;
  }

  .trust-pill {
    display: inline-flex;
    align-items: center;
    padding: 4px 10px;
    border-radius: 999px;
    font-size: 11.5px;
    font-weight: 600;
    border: 1px solid var(--border-color);
    background-color: var(--bg-surface);
    color: var(--text-secondary);
    text-decoration: none;
  }

  .wasm-pill {
    color: var(--accent);
    border-color: var(--accent-border);
    background-color: var(--accent-soft);
  }

  .lang-pill {
    cursor: pointer;
    transition: all 0.2s ease;

    &:hover {
      border-color: var(--accent-border);
      color: var(--accent);
    }
  }

  .tool-hero {
    padding: 20px 24px;
    margin-bottom: 18px;
    border-radius: 16px;
    background: var(--author-banner);
    border: 1px solid var(--border-color);

    @media (max-width: 640px) {
      padding: 16px 14px;
      border-radius: 12px;
      margin-bottom: 14px;
    }
  }

  .tool-h1 {
    margin: 0 0 8px;
    font-size: 22px;
    font-weight: 800;
    color: var(--text-primary);
    line-height: 1.35;

    @media (max-width: 640px) {
      font-size: 18px;
    }
  }

  .tool-lead {
    margin: 0;
    font-size: 14px;
    color: var(--text-secondary);
    line-height: 1.6;

    @media (max-width: 640px) {
      font-size: 13px;
    }
  }

  .hero-related-posts {
    margin-top: 12px;
    padding-top: 12px;
    border-top: 1px dashed var(--border-color);
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px;
  }

  .hero-related-label {
    font-size: 12.5px;
    font-weight: 700;
    color: var(--text-primary);
  }

  .hero-related-links {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .hero-related-pill {
    display: inline-flex;
    align-items: center;
    padding: 4px 12px;
    border-radius: 999px;
    font-size: 12px;
    font-weight: 700;
    color: var(--accent);
    background-color: var(--bg-surface);
    border: 1px solid var(--accent-border);
    text-decoration: none;
    transition: all 0.2s ease;

    &:hover {
      background-color: var(--accent-soft);
      transform: translateY(-1px);
    }
  }

  .tool-workspace {
    margin-bottom: 24px;
    min-width: 0;
    max-width: 100%;
  }

  .tool-seo-article {
    margin-top: 24px;
    padding: 28px 32px;
