<div class="hover-popup relative w-fit font-size-16">
  <slot></slot>
  <div class="hover-popup-content">
    <slot name="content"></slot>
  </div>
</div>
<style lang="less">
  .hover-popup {
    &-content {
      position: absolute;
      display: none;
      margin-top: 8px;
      left: 50%;
      transform: translate(-50%, 0);
      background-color: var(--bg-surface-elevated);
      color: var(--text-primary);
      border: 1px solid var(--border-color);
      border-radius: 10px;
      box-shadow: var(--shadow-lg);
      backdrop-filter: blur(12px);
      width: max-content;
      height: max-content;
      padding: 10px 12px;
      z-index: 100;
      &::before {
        content: ' ';
        position: absolute;
        top: -12px;
        left: calc(50% - 6px);
        width: 0;
        height: 0;
        border-width: 6px;
        border-style: solid;
        border-color: transparent transparent var(--border-color) transparent;
      }
    }
    &:hover .hover-popup-content {
      display: block;
    }
  }
</style>
