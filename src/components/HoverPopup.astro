<div class="hover-popup relative w-fit font-size-16">
  <slot></slot>
  <div class="hover-popup-content">
    <slot name="content"></slot>
  </div>
</div>
<style lang="less">
  .hover-popup {
    position: relative;

    &-content {
      position: absolute;
      display: none;
      top: calc(100% + 10px);
      left: 50%;
      transform: translate(-50%, 0);
      background-color: var(--bg-surface);
      color: var(--text-primary);
      border: 1px solid var(--border-color);
      border-radius: 10px;
      box-shadow: var(--shadow-lg);
      width: max-content;
      height: max-content;
      padding: 10px 12px;
      z-index: 200;

      /* 透明过渡桥，防止鼠标移向浮层时断触 */
      &::after {
        content: '';
        position: absolute;
        top: -12px;
        left: 0;
        right: 0;
        height: 12px;
      }

      &::before {
        content: '';
        position: absolute;
        top: -6px;
        left: calc(50% - 5px);
        width: 10px;
        height: 10px;
        background-color: var(--bg-surface);
        border-left: 1px solid var(--border-color);
        border-top: 1px solid var(--border-color);
        transform: rotate(45deg);
      }
    }

    &:hover .hover-popup-content,
    &:focus-within .hover-popup-content {
      display: block;
    }
  }
</style>
