---
export interface AffiliateOffer {
  badge: string;
  title: string;
  description: string;
  ctaText: string;
  url: string;
  highlight?: string;
}

interface Props {
  lang?: 'zh' | 'en';
  offers: AffiliateOffer[];
}

const { lang = 'zh', offers = [] } = Astro.props;
---

{offers.length > 0 && (
  <section class="affiliate-section" aria-label={lang === 'en' ? 'Recommended Services' : '场景精选推荐'}>
    <div class="affiliate-header">
      <span class="affiliate-title">
        {lang === 'en' ? '💡 Recommended Developer Resources & Cost Savers' : '💡 省钱实战方案 · 开发者精选资源'}
      </span>
      <span class="affiliate-disclosure">
        {lang === 'en' ? 'Partner Links · Zero Extra Cost to You' : '官方合作链接 · 由对应平台提供全部售后保障'}
      </span>
    </div>
    <div class="affiliate-grid">
      {offers.map((offer) => (
        <a
          href={offer.url}
          target="_blank"
          rel="nofollow noopener sponsored"
          class="affiliate-card"
        >
          <div class="card-top">
            <span class="offer-badge">{offer.badge}</span>
            {offer.highlight && <span class="offer-highlight">{offer.highlight}</span>}
          </div>
          <h3 class="offer-title">{offer.title}</h3>
          <p class="offer-desc">{offer.description}</p>
          <span class="offer-cta">{offer.ctaText} →</span>
        </a>
      ))}
    </div>
  </section>
)}

<style lang="less">
  .affiliate-section {
    margin: 24px 0;
    padding: 20px 22px;
    border-radius: 16px;
    background: var(--author-banner);
    border: 1px solid var(--border-color);
  }

  .affiliate-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 14px;
  }

  .affiliate-title {
    font-size: 15px;
    font-weight: 700;
    color: var(--text-primary);
  }

  .affiliate-disclosure {
    font-size: 12px;
    color: var(--text-muted);
  }

  .affiliate-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 14px;

    @media (max-width: 960px) {
      grid-template-columns: 1fr;
    }
  }

  .affiliate-card {
    display: flex;
    flex-direction: column;
    padding: 16px;
    border-radius: 12px;
    background-color: var(--bg-surface);
    border: 1px solid var(--border-color);
    text-decoration: none;
    transition: all 0.2s ease;

    &:hover {
      border-color: var(--accent-border);
      transform: translateY(-2px);
      box-shadow: var(--shadow-md);
    }
  }

  .card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    margin-bottom: 8px;
  }

  .offer-badge {
    font-size: 11px;
    font-weight: 700;
    padding: 2px 8px;
    border-radius: 999px;
    background-color: var(--accent-soft);
    color: var(--accent);
  }

  .offer-highlight {
    font-size: 11px;
    font-weight: 700;
    color: var(--accent-secondary);
  }

  .offer-title {
    margin: 0 0 6px;
    font-size: 15px;
    font-weight: 700;
    color: var(--text-primary);
    line-height: 1.35;
  }

  .offer-desc {
    margin: 0 0 12px;
    font-size: 12.5px;
    color: var(--text-secondary);
    line-height: 1.55;
    flex: 1;
  }

  .offer-cta {
    font-size: 12.5px;
    font-weight: 700;
    color: var(--accent);
  }
</style>
