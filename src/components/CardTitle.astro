---
interface Props {
  'class'?: string;
}

const className = Astro.props.class || '';
---

<h3 class={`card-title ${className}`}>
  <slot></slot>
</h3>
<style lang="less">
  .card-title {
    width: 100%;
    display: flex;
    align-items: center;
    font-size: 15px;
    font-weight: 600;
    color: var(--text-primary);
    gap: 8px;
    margin: 0;
    padding: 0 0 12px;
    border-bottom: 1px dashed var(--border-color);
    &::before {
      content: ' ';
      display: block;
      width: 4px;
      height: 16px;
      border-radius: 999px;
      background-color: var(--accent);
    }
  }
</style>
