---
import { getCollection } from 'astro:content';
import FormattedDate from '@/components/FormattedDate.astro';

const blogs = await getCollection('blog');
const lifes = await getCollection('life');

const posts = [...blogs, ...lifes]
  .filter(({ data }) => data.draft !== true)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const CATEGORY_MAP: Record<string, string> = {
  vue3: 'Vue 3 源码',
  vue: 'Vue 生态',
  knowledge: '技术洞察',
  'front-tools': '前端工程',
  'cocos-creator': '游戏引擎',
  blockchain: 'Web3 · 区块链',
  hybrid: '跨端容器',
};

function getCategoryLabel(collection: string, slug: string): string {
  if (collection === 'life') return '生活随笔';
  const seg = slug.split('/')[0];
  return CATEGORY_MAP[seg] || '技术专栏';
}
---

<ul class="article-grid">
  {
    posts.map((post) => {
      const category = getCategoryLabel(post.collection, post.slug);
      return (
        <li class="article-card">
          <a href={`/${post.collection}/${post.slug}/`} class="article-link">
            <div class="article-meta-top">
              <span class="article-badge">{category}</span>
              <FormattedDate date={post.data.pubDate} />
            </div>
            <h4 class="article-title">{post.data.title}</h4>
            <p class="article-desc">{post.data.description}</p>
            <div class="article-footer">
              <span class="read-more">阅读全文</span>
              <span class="read-arrow" aria-hidden="true">→</span>
            </div>
          </a>
        </li>
      );
    })
  }
</ul>

<style lang="less">
  .article-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
  }

  .article-card {
    background-color: var(--bg-surface);
    border: 1px solid var(--border-color);
    border-radius: 14px;
    box-shadow: var(--shadow-sm);
    transition: transform 0.25s cubic-bezier(0.22, 1, 0.36, 1),
      box-shadow 0.25s ease,
      border-color 0.25s ease,
      background-color 0.25s ease;
    overflow: hidden;

    &:hover {
      transform: translateY(-4px);
      border-color: var(--accent-border);
      box-shadow: var(--shadow-md);
      background-color: var(--bg-surface-hover);

      .article-title {
        color: var(--accent);
      }

      .read-more {
        color: var(--accent);
      }

      .read-arrow {
        transform: translateX(4px);
        color: var(--accent);
      }
    }
  }

  .article-link {
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: 18px 20px;
    text-decoration: none;
    color: inherit;
    box-sizing: border-box;
  }

  .article-meta-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    margin-bottom: 12px;
  }

  .article-badge {
    display: inline-flex;
    align-items: center;
    padding: 2px 9px;
    border-radius: 999px;
    font-size: 11px;
    font-weight: 600;
    color: var(--accent);
    background-color: var(--accent-soft);
    letter-spacing: 0.02em;
  }

  .article-title {
    margin: 0 0 10px;
    font-size: 16px;
    font-weight: 700;
    line-height: 1.45;
    color: var(--text-primary);
    transition: color 0.2s ease;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .article-desc {
    margin: 0 0 16px;
    flex: 1;
    font-size: 13px;
    line-height: 1.65;
    color: var(--text-secondary);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .article-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 12px;
    border-top: 1px dashed var(--border-subtle);
    font-size: 12px;
    font-weight: 500;
    color: var(--text-muted);
  }

  .read-more,
  .read-arrow {
    transition: all 0.2s ease;
  }

  @media (max-width: 1200px) {
    .article-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 640px) {
    .article-grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 12px;
    }
    .article-link {
      padding: 16px;
    }
  }
</style>
