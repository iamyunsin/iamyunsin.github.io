---
interface Props {
	date: Date;
}

const { date } = Astro.props;
---

<time class="formatted-date" datetime={date.toISOString()}>
	{
		date.toLocaleDateString('zh-CN', {
			year: 'numeric',
			month: 'short',
			day: 'numeric',
		})
	}
</time>

<style lang="less">
  .formatted-date {
    font-size: 12px;
    color: var(--text-muted);
    font-variant-numeric: tabular-nums;
  }
</style>
