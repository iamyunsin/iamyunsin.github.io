---
import Card from './Card.astro';
import Avatar from './Avatar.astro';
import { AUTHOR } from '@/consts';
import OutsideLink from '@/components/OutsideLink.astro';
import { Icon } from 'astro-icon/components';
import Iconfont from './Iconfont.astro';
import Popup from './HoverPopup.astro';

interface Props {
  'class'?: string;
}

const className = Astro.props[`class`] || '';
---

<Card class={`author-card ${className}`}>
  <div class="author-banner"></div>
  <div class="author-body">
    <div class="avatar-wrap">
      <Avatar href="/" src={AUTHOR.avatar} size="88" class="b-rd-[50%]" />
    </div>
    <h2 class="author-name">{AUTHOR.name}</h2>
    <p class="author-role">{AUTHOR.description}</p>
    <div class="author-motto">
      <span>“{AUTHOR.motto}”</span>
    </div>
    <div class="author-socials">
      <Popup title="微信">
        <span class="social-btn" aria-label="微信二维码">
          <Iconfont name="wechat" size={18} />
        </span>
        <div slot="content" class="wechat-popup">
          <img src={AUTHOR.wechat} alt="微信二维码" class="w-150 h-150 b-rd-6 block" />
          <p class="wechat-tip">扫码添加微信交流</p>
        </div>
      </Popup>
      <OutsideLink href={AUTHOR.juejin} title="掘金主页">
        <span class="social-btn" aria-label="掘金主页">
          <Iconfont name="juejin" size={18} />
        </span>
      </OutsideLink>
      <OutsideLink href={AUTHOR.github} title="GitHub">
        <span class="social-btn" aria-label="GitHub">
          <Icon name="mdi:github" size={20} />
        </span>
      </OutsideLink>
      <OutsideLink href={AUTHOR.email} title="发送邮件">
        <span class="social-btn" aria-label="发送邮件">
          <Icon name="mdi:email-outline" size={20} />
        </span>
      </OutsideLink>
    </div>
  </div>
</Card>

<style lang="less">
  :global(.author-card) {
    padding: 0 !important;
    overflow: hidden;
    position: relative;
  }

  .author-banner {
    height: 68px;
    width: 100%;
    background: var(--author-banner);
    border-bottom: 1px solid var(--border-subtle);
  }

  .author-body {
    padding: 0 20px 22px;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .avatar-wrap {
    margin-top: -44px;
    margin-bottom: 10px;
  }

  .author-name {
    margin: 0;
    font-size: 18px;
    font-weight: 700;
    color: var(--text-primary);
    letter-spacing: 0.02em;
  }

  .author-role {
    margin: 6px 0 12px;
    font-size: 12px;
    line-height: 1.5;
    color: var(--text-muted);
  }

  .author-motto {
    width: 100%;
    padding: 8px 12px;
    border-radius: 8px;
    background-color: var(--bg-muted);
    border: 1px solid var(--border-subtle);
    font-size: 12px;
    line-height: 1.5;
    color: var(--text-secondary);
    margin-bottom: 16px;
  }

  .author-socials {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
  }

  .social-btn {
    width: 36px;
    height: 36px;
    border-radius: 10px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background-color: var(--bg-muted);
    color: var(--text-secondary);
    border: 1px solid var(--border-color);
    cursor: pointer;
    transition: all 0.2s cubic-bezier(0.22, 1, 0.36, 1);

    &:hover {
      background-color: var(--accent-soft);
      color: var(--accent);
      border-color: var(--accent-border);
      transform: translateY(-2px);
    }
  }

  .wechat-popup {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
  }

  .wechat-tip {
    margin: 0;
    font-size: 12px;
    color: var(--text-muted);
  }
</style>
